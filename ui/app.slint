// CineMosaic window. Look and parts from MediaFiles Check (Theme, CheckButton, Dropdown, Switch). Texts in English in @tr().
import { Palette, Spinner, ListView } from "std-widgets.slint";
import "fonts/JetBrainsMono-Regular.ttf";
import "fonts/JetBrainsMono-Medium.ttf";
import "fonts/JetBrainsMono-SemiBold.ttf";
import "fonts/JetBrainsMono-Bold.ttf";

export struct MenuChoice {
    title: string,
    checked: bool,
}

// a colour preset of the frame line or headline: as typed and as Rust read it
// a master file in the Source tab with its film range (master timecode, "" = no limit)
export struct MasterRow {
    name: string,
    from: string,
    to: string,
}

// where a text lies on the page, as fractions of the page (w 0 = nothing drawn)
export struct TextBox {
    x: float,
    y: float,
    w: float,
    h: float,
}

export struct Swatch {
    hex: string,
    c: color,
}

export struct HelpBlock {
    heading: string,
    body: styled-text,
    // screenshot (2x pixels), shown at half its pixel size, never wider than the text
    picture: image,
}

export struct TestRow {
    title: string,
    detail: string,
    status: int,
}

export struct VolumeRow {
    name: string,
    on: bool,
}

export global Metrics {
    out property <length> side-width: 380px;
    // wrapped texts need a fixed width: the side column minus its padding
    out property <length> text-width: 380px - 2 * 28px;
    // manual window
    out property <length> padding: 32px;
    out property <length> spacing: 24px;
}

export global Theme {
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    out property <color> background: dark ? #1f2225 : #f5f5f3;
    out property <color> text: dark ? #eceded : #17191b;
    out property <color> muted: dark ? #a9adb1 : #3f444a;
    out property <color> faint: dark ? #858b91 : #60666c;
    out property <color> line: dark ? #3a3f44 : #c4c8cc;
    out property <color> disabled: dark ? #6a7076 : #70767c;
    out property <color> primary: dark ? #e6e7e8 : #2e3236;
    out property <color> on-primary: dark ? #1f2225 : #f5f5f3;
    out property <color> error: dark ? #f85149 : #c62828;
    out property <color> accent: dark ? #0a84ff : #007aff;
    out property <color> online: dark ? #3fb950 : #1a7f37;
    out property <color> partial: dark ? #f0883e : #b4530f;
    out property <color> sidebar: dark ? #232629 : #ececea;
    // the preview's desk behind the white page
    out property <color> desk: dark ? #16181a : #dcdcd9;
}

component Headline inherits VerticalLayout {
    padding-bottom: 6px;
    Text {
        text: "CINEMOSAIC";
        font-family: "Helvetica Neue";
        font-size: 31px;
        font-weight: 300;
        letter-spacing: 2.5px;
        color: Theme.text;
    }
}

component SectionLabel inherits Text {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1px;
    color: Theme.muted;
}

component Para inherits Text {
    width: Metrics.text-width;
    wrap: word-wrap;
    font-size: 11px;
    color: Theme.faint;
}

component CheckButton {
    in property <string> text;
    in property <bool> primary;
    in property <bool> enabled: true;
    in property <bool> small;
    callback clicked;
    min-width: label.preferred-width + (root.small ? 24px : 28px);
    preferred-width: self.min-width;
    height: root.small ? 26px : 32px;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    Rectangle {
        border-radius: 6px;
        border-width: 1px;
        border-color: root.primary && root.enabled ? Theme.primary : Theme.line;
        background: !root.enabled ? transparent
            : root.primary ? (touch.pressed ? Theme.primary.darker(0.15) : Theme.primary)
            : touch.pressed ? Theme.text.with-alpha(0.12) : touch.has-hover ? Theme.text.with-alpha(0.06) : transparent;
    }
    label := Text {
        text: root.text;
        font-size: root.small ? 12px : 13px;
        font-weight: root.small ? (root.primary ? 700 : 600) : root.primary ? 600 : 400;
        color: !root.enabled ? Theme.disabled : root.primary ? Theme.on-primary : Theme.text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

// Mountpoint switch: capsule 34 × 20, knob right = on
component Switch inherits Rectangle {
    in property <bool> on;
    in property <string> label;
    in property <bool> enabled: true;
    callback toggled;
    width: 34px;
    opacity: root.enabled ? 1 : 0.5;
    height: 20px;
    border-radius: 10px;
    background: root.on ? Theme.primary : Theme.line;
    accessible-role: switch;
    accessible-label: root.label;
    accessible-checked: root.on;
    accessible-action-default => { if root.enabled { root.toggled(); } }
    Rectangle {
        x: root.on ? parent.width - self.width - 2px : 2px;
        y: 2px;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: root.on ? Theme.on-primary : (Theme.dark ? Theme.muted : Theme.background);
        animate x { duration: 150ms; easing: ease-out; }
    }
    TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }
}

// Mountpoint dropdown button: Ferry-style frame with the value and a chevron. The dropdowns below put it inside a
// ContextMenuArea with their own native menu, which opens below the button on a click.
component MenuButton {
    in property <string> text;
    in property <string> label;
    // long values are cut off with "…" (the sequence list)
    in property <length> text-max: 1000px;
    in property <bool> enabled: true;
    callback clicked;
    height: 26px;
    min-width: row.preferred-width;
    max-width: row.preferred-width;
    horizontal-stretch: 0;
    accessible-role: combobox;
    accessible-label: root.label;
    accessible-value: root.text;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    Rectangle {
        border-radius: 6px;
        border-width: 1px;
        border-color: Theme.line;
        background: touch.pressed ? Theme.text.with-alpha(0.12) : touch.has-hover ? Theme.text.with-alpha(0.06) : transparent;
    }
    row := HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 6px;
        Text { text: root.text; font-size: 12px; vertical-alignment: center; color: root.enabled ? Theme.text : Theme.disabled; overflow: elide; max-width: root.text-max; }
        VerticalLayout {
            alignment: center;
            Path { width: 8px; height: 5px; commands: "M 0 0 L 4 4 L 8 0"; stroke: root.enabled ? Theme.text : Theme.disabled; stroke-width: 1.5px; }
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Choice from a list: the native menu, the current entry disabled
component Dropdown {
    in property <[string]> items;
    in property <int> current;
    in property <string> label;
    in property <bool> enabled: true;
    callback selected(int);
    min-width: b.min-width;
    max-width: b.max-width;
    height: b.height;
    horizontal-stretch: 0;
    menu := ContextMenuArea {
        Menu {
            for item[i] in root.items: MenuItem {
                title: item;
                enabled: i != root.current;
                activated => { root.selected(i); }
            }
        }
        b := MenuButton { text: root.items[root.current]; label: root.label; enabled: root.enabled; clicked => { menu.show({ x: 0, y: root.height + 4px }); } }
    }
}

// Dropdown whose menu ticks entries (`checked`); choosing one does not close the choice for the others – the menu
// opens again with the next click
component CheckDropdown {
    in property <[MenuChoice]> entries;
    in property <string> text;
    in property <string> label;
    in property <bool> enabled: true;
    callback selected(int);
    min-width: b.min-width;
    max-width: b.max-width;
    height: b.height;
    horizontal-stretch: 0;
    menu := ContextMenuArea {
        Menu {
            for e[i] in root.entries: MenuItem {
                title: e.title;
                checkable: true;
                checked: e.checked;
                activated => { root.selected(i); }
            }
        }
        b := MenuButton { text: root.text; label: root.label; text-max: 220px; enabled: root.enabled; clicked => { menu.show({ x: 0, y: root.height + 4px }); } }
    }
}

// Dropdown with sections: entries whose `checked` is set are section titles (not choosable); the button shows `text`
// (the menu entries may be longer)
component SectionDropdown {
    in property <[MenuChoice]> entries;
    in property <int> current;
    in property <string> text;
    in property <string> label;
    callback selected(int);
    min-width: b.min-width;
    max-width: b.max-width;
    height: b.height;
    horizontal-stretch: 0;
    menu := ContextMenuArea {
        Menu {
            for e[i] in root.entries: MenuItem {
                title: e.checked ? e.title.to-uppercase() : e.title;
                enabled: !e.checked && i != root.current;
                activated => { root.selected(i); }
            }
        }
        b := MenuButton { text: root.text; label: root.label; clicked => { menu.show({ x: 0, y: root.height + 4px }); } }
    }
}

// Presets: the presets (the current one disabled) plus new / update / rename / delete
component PresetMenu {
    in property <[string]> items;
    in property <int> current;
    in property <string> title;
    callback chosen(int);
    callback new();
    callback update();
    callback rename();
    callback delete();
    min-width: b.min-width;
    max-width: b.max-width;
    height: b.height;
    horizontal-stretch: 0;
    menu := ContextMenuArea {
        Menu {
            for item[i] in root.items: MenuItem { title: item; enabled: i != root.current; activated => { root.chosen(i); } }
            if root.items.length > 0: MenuSeparator {}
            MenuItem { title: @tr("New preset…"); activated => { root.new(); } }
            if root.current >= 0: MenuItem { title: @tr("Update with current settings"); activated => { root.update(); } }
            if root.current >= 0: MenuItem { title: @tr("Rename…"); activated => { root.rename(); } }
            if root.current >= 0: MenuItem { title: @tr("Delete…"); activated => { root.delete(); } }
        }
        b := MenuButton { text: root.title; label: @tr("Preset"); clicked => { menu.show({ x: 0, y: root.height + 4px }); } }
    }
}

// Number with its unit; frame like Mountpoint's text fields, red when Rust could not read it
component NumberField inherits Rectangle {
    in-out property <string> text;
    in property <string> unit;
    in property <string> label;
    in property <bool> invalid;
    // dragging left / right in the field changes the value by `scrub` per pixel, rounded to `step` (0 = off);
    // a click without dragging types as usual
    in property <float> scrub: 0;
    in property <float> step: 1;
    in property <float> minimum: 0;
    in property <float> maximum: 1000000000;
    callback edited();
    width: 96px;
    height: 26px;
    border-radius: 6px;
    border-width: 1px;
    border-color: root.invalid ? Theme.error : input.has-focus ? Theme.accent : Theme.line;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 4px;
        input := TextInput {
            text <=> root.text;
            font-size: 12px;
            color: Theme.text;
            vertical-alignment: center;
            horizontal-alignment: right;
            single-line: true;
            accessible-label: root.label;
            edited => { root.edited(); }
        }
        Text {
            text: root.unit;
            font-size: 12px;
            color: Theme.faint;
            vertical-alignment: center;
            horizontal-stretch: 0;
        }
    }
    if root.scrub > 0 && !input.has-focus: TouchArea {
        property <float> v0;
        property <bool> dragged;
        mouse-cursor: ew-resize;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                self.v0 = root.text.is-float() ? root.text.to-float() : root.minimum;
                self.dragged = false;
            }
            if e.kind == PointerEventKind.up && !self.dragged {
                input.focus();
                input.select-all();
            }
        }
        moved => {
            if self.pressed {
                let d = (self.mouse-x - self.pressed-x) / 1px;
                if Math.abs(d) > 2 { self.dragged = true; }
                if self.dragged {
                    let v = Math.round((self.v0 + d * root.scrub) / root.step) * root.step;
                    root.text = Math.round(min(root.maximum, max(root.minimum, v)) * 100) / 100;
                    root.edited();
                }
            }
        }
    }
}

// A timecode field like in editing apps: a click chooses hours, minutes, seconds or frames (highlighted), two digits
// replace that part and the next one is chosen, ↑ / ↓ count it, ← / → choose the neighbour. Double-click, ⌘A or Tab
// choose everything: digits then fill from the right like in Avid ("1234" → 00:00:12:34), Backspace empties the field.
// ⌘V pastes a timecode. Empty shows 00:00:00:00 in grey (= no limit). The keys go to Rust (`edit`).
export struct TcState {
    text: string,
    // -1 nothing, 0–3 one part, 4 everything, 5 typing the whole timecode
    sel: int,
    // digits typed into the chosen part
    typed: int,
}

component TcField inherits Rectangle {
    in-out property <string> text;
    in property <string> label;
    in property <bool> enabled: true;
    pure callback edit(TcState, string, bool) -> TcState;
    callback paste(TcState) -> TcState;
    pure callback parts(string) -> [string];
    // focus left: the value is final
    callback done();
    property <int> sel: -1;
    property <int> typed;
    function apply(r: TcState) {
        root.text = r.text;
        root.sel = r.sel;
        root.typed = r.typed;
    }
    function choose(i: int) {
        root.sel = i;
        root.typed = 0;
        scope.focus();
    }
    width: 116px;
    height: 26px;
    border-radius: 6px;
    border-width: 1px;
    border-color: scope.has-focus ? Theme.accent : Theme.line;
    accessible-role: text-input;
    accessible-label: root.label;
    accessible-value: root.text;
    opacity: root.enabled ? 1 : 0.5;
    scope := FocusScope {
        enabled: root.enabled;
        changed has-focus => {
            if self.has-focus {
                // reached with Tab: everything chosen, as in a text field
                if root.sel == -1 { root.sel = 4; }
            } else {
                root.sel = -1;
                root.typed = 0;
                root.done();
            }
        }
        key-pressed(e) => {
            if e.text == Key.Tab || e.text == Key.Backtab {
                return reject;
            }
            if e.text == Key.Return || e.text == Key.Escape {
                self.clear-focus();
                return accept;
            }
            if e.modifiers.meta && (e.text == "v" || e.text == "V") {
                root.apply(root.paste({ text: root.text, sel: root.sel, typed: root.typed }));
                return accept;
            }
            if (e.modifiers.meta || e.modifiers.control) && e.text != "a" && e.text != "A" {
                return reject;
            }
            root.apply(root.edit({ text: root.text, sel: root.sel, typed: root.typed }, e.text, e.modifiers.meta));
            accept
        }
        // a click beside the digits: everything
        TouchArea {
            enabled: root.enabled;
            mouse-cursor: MouseCursor.text;
            clicked => { root.choose(4); }
        }
        HorizontalLayout {
            padding-left: 6px;
            padding-right: 6px;
            alignment: end;
            for part[i] in root.parts(root.text): HorizontalLayout {
                if i > 0: Text {
                    text: ":";
                    font-size: 12px;
                    color: root.text == "" ? Theme.disabled : Theme.muted;
                    vertical-alignment: center;
                }
                Rectangle {
                    y: 4px;
                    height: parent.height - 8px;
                    width: t.preferred-width + 4px;
                    border-radius: 3px;
                    background: scope.has-focus && (root.sel == i || root.sel == 4) ? Theme.accent.with-alpha(0.45) : transparent;
                    t := Text {
                        text: part;
                        font-size: 12px;
                        color: root.text == "" ? Theme.disabled : Theme.text;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                    TouchArea {
                        enabled: root.enabled;
                        mouse-cursor: MouseCursor.text;
                        clicked => { root.choose(i); }
                        double-clicked => { root.choose(4); }
                    }
                }
            }
        }
    }
}

// A chosen file: its name, and right-aligned a small × that removes it from the list
component FileRow inherits HorizontalLayout {
    in property <string> text;
    in property <bool> enabled: true;
    callback removed();
    height: 22px;
    spacing: 8px;
    Text { text: root.text; font-size: 12px; color: Theme.muted; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
    Rectangle {
        width: 20px;
        height: 20px;
        border-radius: 4px;
        background: x.pressed ? Theme.text.with-alpha(0.14) : x.has-hover ? Theme.text.with-alpha(0.07) : transparent;
        accessible-role: button;
        accessible-label: @tr("Remove {}", root.text);
        accessible-action-default => { if root.enabled { root.removed(); } }
        Text { text: "×"; font-size: 14px; color: root.enabled ? Theme.muted : Theme.disabled; horizontal-alignment: center; vertical-alignment: center; }
        x := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.removed(); } }
    }
}

// Short text left, control right
component Row inherits HorizontalLayout {
    in property <string> text;
    spacing: 10px;
    height: 30px;
    Text {
        text: root.text;
        font-size: 12px;
        horizontal-stretch: 1;
        vertical-alignment: center;
        color: Theme.text;
    }
    @children
}

component ProgressBar inherits Rectangle {
    in property <float> value;
    height: 6px;
    border-radius: 3px;
    background: Theme.line;
    Rectangle {
        x: 0;
        width: parent.width * clamp(root.value, 0, 1);
        border-radius: 3px;
        background: Theme.primary;
    }
}

export global Shared {
    // Größe des Fensters hat sich geändert (jedes Fenster hat sein eigenes Shared)
    callback resized();
    in property <[MenuChoice]> languages;
    in property <[string]> language-names;
    in property <int> language-index;
    in property <[bool]> appearance;
    in property <bool> dark: true;
    in property <bool> betas;
    callback select-language(int);
    callback select-dark(bool);
    callback select-betas(bool);
    callback show-help();
    callback show-about();
    callback show-settings();
    callback show-log();
    // File menu (projects); recent = names of the projects opened last, newest first
    in property <[string]> recent;
    callback new-project();
    callback open-project();
    callback open-recent(int);
    callback clear-recent();
    callback save-project();
    callback save-project-as();
    callback close-window();
    // Updates (src/update.rs): laufende Version, neuere Version ("" = keine), Zustand 0 nichts, 1 prüft, 2 aktuell,
    // 3 installiert, 4 Fehler; Fehlerart 0 Prüfen, 1 Laden, 2 beschädigt, 3 Ersetzen, 4 Neustart
    in property <string> version;
    in property <string> update-version;
    in property <int> update-state;
    in property <int> update-error;
    in property <string> update-details;
    callback check-update();
    callback install-update();
    callback show-release();
    // Rust: Update-Zustand hat sich geändert, alle Fenster neu setzen
    callback refresh-update();
}


// Zustand der Updates als Text (Einstellungen und Banner)
component UpdateStatus inherits Text {
    width: Metrics.text-width;
    wrap: word-wrap;
    font-size: 12px;
    visible: self.text != "";
    height: self.visible ? self.preferred-height : 0;
    color: Shared.update-state == 4 ? Theme.error : Theme.muted;
    text: Shared.update-state == 1 ? @tr("Checking for updates…")
        : Shared.update-state == 2 ? @tr("CineMosaic is up to date.")
        : Shared.update-state == 3 ? @tr("Installing the update – CineMosaic restarts by itself.")
        : Shared.update-state != 4 ? ""
        : Shared.update-error == 0 ? @tr("Could not check for updates. Check the internet connection and try again.")
        : Shared.update-error == 1 ? @tr("The update could not be downloaded. Check the internet connection and try again.")
        : Shared.update-error == 2 ? @tr("The downloaded update is damaged. Please try again later or download it from GitHub.")
        : Shared.update-error == 3 ? @tr("CineMosaic could not replace itself. Move it to the Applications folder, or download the update from GitHub. Details: {}", Shared.update-details)
        : @tr("The update is installed. Quit CineMosaic and open it again to finish.");
}

// Neue Version: Hinweis mit "Neuigkeiten" und "Update installieren" (oben im Hauptfenster und in den Einstellungen)
component UpdateOffer inherits VerticalLayout {
    in property <length> text-width: Metrics.text-width;
    spacing: 10px;
    Text {
        width: root.text-width;
        wrap: word-wrap;
        text: @tr("Version {} is available.", Shared.update-version);
        font-weight: 600;
        color: Theme.text;
    }
    HorizontalLayout {
        spacing: 10px;
        alignment: start;
        CheckButton {
            text: @tr("What's new");
            clicked => { Shared.show-release(); }
        }
        CheckButton {
            text: @tr("Install update");
            primary: true;
            enabled: Shared.update-state != 3;
            clicked => { Shared.install-update(); }
        }
    }
}

// New version in the main window: a card floating at the bottom centre over everything, rounded corners and a
// soft shadow, like Fona (user 2026-11-23: every app does it this way, never somewhere inside the UI)
component UpdateCard inherits Rectangle {
    width: min(row.preferred-width + 28px, 640px);
    height: col.preferred-height + 24px;
    border-radius: 12px;
    background: Theme.background;
    border-width: 1px;
    border-color: Theme.line;
    drop-shadow-blur: 16px;
    drop-shadow-offset-y: 4px;
    drop-shadow-color: #00000040;
    accessible-role: groupbox;
    accessible-label: @tr("Version {} is available.", Shared.update-version);
    col := VerticalLayout {
        x: 14px;
        y: 12px;
        width: parent.width - 28px;
        spacing: 6px;
        row := HorizontalLayout {
            spacing: 12px;
            VerticalLayout {
                alignment: center;
                // arrow in a circle: download
                Path {
                    width: 18px;
                    height: 18px;
                    viewbox-width: 18;
                    viewbox-height: 18;
                    commands: "M 9 1 A 8 8 0 1 1 8.99 1 Z M 9 5 L 9 12.5 M 5.5 9.5 L 9 13 L 12.5 9.5";
                    stroke: Theme.text;
                    stroke-width: 1.5px;
                    fill: transparent;
                }
            }
            Text {
                text: @tr("Version {} is available.", Shared.update-version);
                font-weight: 600;
                color: Theme.text;
                vertical-alignment: center;
                overflow: elide;
            }
            CheckButton { small: true; text: @tr("What's new"); clicked => { Shared.show-release(); } }
            CheckButton { small: true; text: @tr("Install update"); primary: true; enabled: Shared.update-state != 3; clicked => { Shared.install-update(); } }
        }
        if Shared.update-state == 3 || Shared.update-state == 4: UpdateStatus { width: parent.width; font-size: 11px; }
    }
}

// Base of every window: app font, colours from Shared.dark, Help menu (on the Mac the menu belongs to the active window)
component SheetWindow inherits Window {
    default-font-family: "JetBrains Mono";
    default-font-size: 13px;
    background: Theme.background;
    property <bool> dark: Shared.dark;
    init => {
        Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light;
    }
    changed dark => {
        Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light;
    }
    changed height => { Shared.resized(); }
    MenuBar {
        Menu {
            title: @tr("File");
            MenuItem { title: @tr("New Project"); shortcut: @keys(Control + N); activated => { Shared.new-project(); } }
            MenuItem { title: @tr("Open Project…"); shortcut: @keys(Control + O); activated => { Shared.open-project(); } }
            Menu {
                title: @tr("Open Recent");
                for name[i] in Shared.recent: MenuItem { title: name; activated => { Shared.open-recent(i); } }
                MenuSeparator { }
                MenuItem { title: @tr("Clear Menu"); enabled: Shared.recent.length > 0; activated => { Shared.clear-recent(); } }
            }
            MenuSeparator { }
            MenuItem { title: @tr("Close Window"); shortcut: @keys(Control + W); activated => { Shared.close-window(); } }
            MenuItem { title: @tr("Save Project"); shortcut: @keys(Control + S); activated => { Shared.save-project(); } }
            MenuItem { title: @tr("Save Project As…"); shortcut: @keys(Control + Shift + S); activated => { Shared.save-project-as(); } }
        }
        Menu {
            title: @tr("Help");
            MenuItem {
                title: @tr("CineMosaic Manual");
                activated => { Shared.show-help(); }
            }
            MenuItem {
                title: @tr("Show Log File");
                activated => { Shared.show-log(); }
            }
        }
    }
}

component SettingsTab {
    in property <image> icon;
    in property <string> text;
    in property <bool> selected;
    // kleiner oranger Punkt: dort wartet etwas (Hauptfenster)
    in property <bool> attention;
    callback clicked;
    min-width: max(label.preferred-width + 14px, 44px);
    height: 45px;
    accessible-role: tab;
    accessible-label: root.text;
    accessible-checked: root.selected;
    accessible-description: root.attention ? @tr("needs attention") : "";
    accessible-action-default => { root.clicked(); }
    Rectangle {
        border-radius: 6px;
        background: root.selected ? (Theme.dark ? #ffffff14 : #00000012) : transparent;
    }
    VerticalLayout {
        padding-top: 2px;
        padding-bottom: 2px;
        spacing: 0px;
        alignment: center;
        HorizontalLayout {
            alignment: center;
            Image {
                source: root.icon;
                width: 23px;
                height: 23px;
                colorize: root.selected ? Theme.accent : label.color;
                if root.attention: Rectangle {
                    x: parent.width - 3px;
                    y: -1px;
                    width: 7px;
                    height: 7px;
                    border-radius: 3.5px;
                    background: Theme.partial;
                }
            }
        }
        label := Text {
            text: root.text;
            // Systemschrift-Alias verlor in Slint Umlaute („Über“ → „Uber“); Helvetica Neue gibt es auf jedem Mac
            font-family: "Helvetica Neue";
            font-size: 12px;
            horizontal-alignment: center;
            // dunkel 55 % Weiß (4.8:1), hell 65 % Schwarz (5.9:1 auf #f0f0f0; 50 % wären nur 3.9:1)
            color: root.selected ? Theme.accent : Theme.dark ? #ffffff8c : #000000a6;
        }
    }
    TouchArea {
        clicked => { root.clicked(); }
    }
}

component Section inherits VerticalLayout {
    in property <string> title;
    spacing: 10px;
    Text {
        text: root.title;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 1px;
        color: Theme.muted;
    }
    @children
}

component Divider inherits Rectangle {
    height: 1px;
    background: Theme.line;
}


component ScrollThumb inherits Rectangle {
    in property <length> view;
    in property <length> content;
    in property <length> offset;
    // height the thumb runs along (a card with padding: the whole card, not only its scrolling part)
    in property <length> track: root.view;
    visible: root.content > root.view;
    width: 6px;
    height: max(24px, (root.track - 4px) * root.view / max(root.content, 1px));
    y: 2px + (root.content > root.view ? -root.offset / (root.content - root.view) * (root.track - 4px - self.height) : 0px);
    border-radius: 3px;
    background: Theme.dark ? #ffffff59 : #00000059;
}


export component HelpWindow inherits SheetWindow {
    title: @tr("CineMosaic Manual");
    width: 720px;
    height: 860px;

    in property <string> subtitle;
    in property <[HelpBlock]> blocks;

    VerticalLayout {
        padding: Metrics.padding;
        spacing: Metrics.spacing;

        Headline { }
        Section {
            title: root.subtitle;
        }
        Divider { }
        // eigene Scrollfläche: die Standard-ScrollView rückt den Inhalt ein
        Rectangle {
            vertical-stretch: 1;
            flick := Flickable {
                content-height: content.preferred-height;
                content := VerticalLayout {
                    x: 0;
                    width: flick.width - 16px;
                    spacing: 12px;
                    padding-bottom: 16px;
                    for b in root.blocks: VerticalLayout {
                        padding-top: b.heading != "" ? 16px : 0;
                        if b.heading != "": Text {
                            text: b.heading;
                            font-size: 15px;
                            font-weight: 600;
                            wrap: word-wrap;
                            color: Theme.text;
                        }
                        // feste Breite: sonst misst Slint den Absatz ungebrochen und die Scrollhöhe ist zu klein
                        // framed: the screenshots are dark and would blend into the page
                        if b.picture.width > 0: Rectangle {
                            width: min(content.width, b.picture.width * 0.5px + 2px);
                            height: (self.width - 2px) * b.picture.height / b.picture.width + 2px;
                            border-width: 1px;
                            border-color: Theme.line;
                            border-radius: 6px;
                            clip: true;
                            Image {
                                x: 1px;
                                y: 1px;
                                width: parent.width - 2px;
                                height: parent.height - 2px;
                                source: b.picture;
                            }
                        }
                        if b.heading == "" && b.picture.width == 0: StyledText {
                            width: content.width;
                            text: b.body;
                            default-color: Theme.text;
                            link-color: Theme.text;
                        }
                    }
                }
            }
            if flick.content-height > flick.height: Rectangle {
                x: parent.width - self.width;
                width: 4px;
                height: max(24px, flick.height * flick.height / flick.content-height);
                y: -flick.content-y / (flick.content-height - flick.height) * (flick.height - self.height);
                border-radius: 2px;
                background: Theme.line;
            }
        }
    }
}

// Zeile wie in Mountpoint: kurzer Text links, Bedienelement rechtsbündig
component SettingRow inherits HorizontalLayout {
    in property <string> text;
    spacing: 10px;
    Text {
        text: root.text;
        // Mountpoints Regular wirkt mit CoreText (dunkel, kleine Größen) fast halbfett; Slint zeichnet dünner
        font-weight: 600;
        horizontal-stretch: 1;
        vertical-alignment: center;
        wrap: word-wrap;
        color: Theme.text;
    }
    @children
}

// Erklärung unter einer Zeile (Mountpoint: hint, 11 pt, blass, höchstens 390 breit)
component Hint inherits Text {
    width: 390px;
    wrap: word-wrap;
    font-size: 11px;
    color: Theme.faint;
}

// Rollbalken wie macOS' Overlay-Scroller in Mountpoints ScrollView: 6 px, abgerundet, 2 px vom Rand

// Rahmen wie Mountpoints Eingabefelder: 1 px Linie, Ecken 6, keine eigene Fläche
component FieldFrame inherits Rectangle {
    border-radius: 6px;
    border-width: 1px;
    border-color: Theme.line;
    clip: true;
}

// Einstellungen wie in Mountpoint (seit 1.0.0 beta 7): eigenes Fenster 800 × 450 (16:9, nie größer), Inhalt bis unter die
// durchsichtige Titelleiste (Rust: mac_window::unify_titlebar), Reiterleiste in der Farbe der Titelleiste – heller,
// solange das Fenster aktiv ist (active, von Rust gesetzt) –, Titel = Reiter, Spalte von 560 px mittig.
// Kein Reiter wächst oder scrollt – nur die Selbsttest-Liste und das Beschreibungsfeld scrollen in sich.
export component SettingsWindow inherits SheetWindow {
    // gleiche Wirkung wie Mountpoints Regular mit CoreText (gemessen: Slint-Text sonst rund 20 % heller)
    default-font-weight: 500;
    title: root.tab == 0 ? @tr("General") : root.tab == 1 ? @tr("Updates") : root.tab == 2 ? @tr("Support") : @tr("About");
    width: 800px;
    height: 450px;

    // Reiter: 0 Allgemein, 1 Updates, 2 Support, 3 Über; last-tab = zuletzt gewählter außer „Über“ (für „Einstellungen…“,
    // in settings.txt gesichert)
    in-out property <int> tab;
    in-out property <int> last-tab;
    callback tab-chosen(int);
    changed tab => {
        if root.tab != 3 && root.tab != root.last-tab {
            root.last-tab = root.tab;
            root.tab-chosen(root.tab);
        }
    }
    in property <bool> active: true;
    in property <string> version;
    callback open-source();
    callback open-license();
    // Support (wie Mountpoint): 0 Übersicht, 1 Selbsttest, 2 Problem melden
    in-out property <int> page;
    // Selbsttest: 0 bereit, 1 läuft, 2 fertig
    in property <int> test-phase;
    in property <[TestRow]> test-rows;
    in property <string> test-current;
    in property <string> test-summary;
    in property <bool> test-failed;
    in property <string> test-note;
    in property <bool> sending;
    in-out property <string> report-text;
    in-out property <string> report-contact;
    in-out property <bool> report-attach: true;
    // kurze Meldung nach dem Senden wie Mountpoints Toast (Rust blendet sie nach 3 s, Fehler 8 s, aus)
    in property <string> toast-text;
    in property <bool> toast-ok;
    in property <bool> toast-visible;
    callback start-selftest();
    callback send-selftest();
    callback save-selftest();
    callback send-problem();
    callback open-coffee();
    callback back();

    property <length> column: 560px;

    VerticalLayout {
        // Titelleiste (28) + Reiter (52), gemessen an Mountpoint
        Rectangle {
            height: 80px;
            background: Theme.dark ? (root.active ? #383838 : #292929) : (root.active ? #f0f0f0 : #e7e7e7);
            HorizontalLayout {
                alignment: center;
                padding-top: 28px;
                padding-bottom: 7px;
                SettingsTab {
                    icon: @image-url("../assets/tabs/general.png");
                    text: @tr("General");
                    selected: root.tab == 0;
                    clicked => { root.tab = 0; }
                }
                SettingsTab {
                    icon: @image-url("../assets/tabs/updates.png");
                    text: @tr("Updates");
                    selected: root.tab == 1;
                    clicked => { root.tab = 1; }
                }
                SettingsTab {
                    icon: @image-url("../assets/tabs/support.png");
                    text: @tr("Support");
                    selected: root.tab == 2;
                    clicked => { root.tab = 2; }
                }
                SettingsTab {
                    icon: @image-url("../assets/tabs/about.png");
                    text: @tr("About");
                    selected: root.tab == 3;
                    clicked => { root.tab = 3; }
                }
            }
        }
        // Trennlinie unter der Werkzeugleiste wie bei macOS (ein Bildpunkt)
        Rectangle {
            height: 0.5px;
            background: Theme.dark ? #000000 : #c6c6c6;
        }
        HorizontalLayout {
            alignment: center;
            // Allgemein ist der Maßstab (wie Mountpoint): seine erste Zeile hat einen Schalter (20 hoch). Reiter, die mit
            // einem Knopf (26 hoch) beginnen, rücken 3 px höher, damit der erste Text überall auf derselben Höhe steht.
            padding-top: root.tab == 2 && root.page != 0 ? 16px : root.tab == 1 || root.tab == 2 ? 21px : 24px;
            padding-bottom: 16px;

            if root.tab == 0: VerticalLayout {
                width: root.column;
                alignment: start;
                spacing: 14px;
                SettingRow {
                    text: @tr("Light/Dark");
                    VerticalLayout {
                        alignment: center;
                        Switch {
                            on: Shared.dark;
                            label: @tr("Light/Dark");
                            toggled => { Shared.select-dark(!Shared.dark); }
                        }
                    }
                }
                Hint { text: @tr("Switches all windows of CineMosaic between a light and a dark look."); }
                SettingRow {
                    text: @tr("Language");
                    VerticalLayout {
                        alignment: center;
                        Dropdown {
                            items: Shared.language-names;
                            current: Shared.language-index;
                            selected(i) => { Shared.select-language(i); }
                        }
                    }
                }
            }

            if root.tab == 1: VerticalLayout {
                width: root.column;
                alignment: start;
                spacing: 14px;
                SettingRow {
                    text: @tr("Version {}", Shared.version);
                    if Shared.update-state == 1: VerticalLayout {
                        alignment: center;
                        Spinner { indeterminate: true; width: 16px; height: 16px; }
                    }
                    CheckButton {
                        small: true;
                        text: @tr("Check for updates");
                        enabled: Shared.update-state != 1 && Shared.update-state != 3;
                        clicked => { Shared.check-update(); }
                    }
                }
                if Shared.update-version != "": UpdateOffer { text-width: root.column; }
                if Shared.update-state != 0: UpdateStatus {
                    width: root.column;
                    font-size: 11px;
                    color: Shared.update-state == 4 ? Theme.partial : Theme.faint;
                }
                Hint { text: @tr("CineMosaic checks GitHub for new versions on its own and shows a notice."); }
                SettingRow {
                    text: @tr("Get test versions");
                    VerticalLayout {
                        alignment: center;
                        Switch {
                            on: Shared.betas;
                            label: @tr("Get test versions");
                            toggled => { Shared.select-betas(!Shared.betas); }
                        }
                    }
                }
                Hint { text: @tr("Also offers versions that are still being tested. For testers only – they can contain errors."); }
            }

            if root.tab == 2 && root.page == 0: VerticalLayout {
                width: root.column;
                alignment: start;
                spacing: 14px;
                SettingRow {
                    text: root.test-phase == 1 ? @tr("Self-test running…") : @tr("Test this Mac");
                    CheckButton {
                        small: true;
                        text: @tr("Run self-test…");
                        clicked => { root.page = 1; }
                    }
                }
                Hint { text: @tr("Tests ffmpeg, grabbing frames, reading cut lists, saving sheets and updates on test data of its own and sends us an anonymous report."); }
                SettingRow {
                    text: @tr("Problem or idea?");
                    CheckButton {
                        small: true;
                        text: @tr("Report…");
                        clicked => { root.page = 2; }
                    }
                }
                Hint { text: @tr("No GitHub account needed."); }
                SettingRow {
                    text: @tr("Events and errors");
                    CheckButton {
                        small: true;
                        text: @tr("Show log file");
                        clicked => { Shared.show-log(); }
                    }
                }
                SettingRow {
                    text: @tr("Like CineMosaic?");
                    CheckButton {
                        small: true;
                        text: @tr("Buy me a coffee");
                        clicked => { root.open-coffee(); }
                    }
                }
                Hint { text: @tr("If you use CineMosaic and like it, I would be glad if you bought me a coffee."); }
            }

            // Selbsttest wie Mountpoints SelfTestView: feste Liste mit Rahmen, die mitscrollt – das Fenster wächst nie
            if root.tab == 2 && root.page == 1: VerticalLayout {
                width: root.column;
                alignment: start;
                // Liste 200 hoch wie in Mountpoint: etwas engere Abstände, damit alles ohne Scrollen passt
                spacing: 10px;
                Section {
                    title: @tr("SELF-TEST");
                    spacing: 8px;
                    if root.test-phase == 0: Text {
                        width: root.column;
                        wrap: word-wrap;
                        font-size: 12px;
                        color: Theme.muted;
                        text: @tr("CineMosaic tests ffmpeg, grabbing frames, reading cut lists, saving sheets and updates on test data of its own and sends us an anonymous report. Your volumes are only listed, never changed. It takes less than a minute.");
                    }
                    if root.test-phase != 0: FieldFrame {
                        height: 200px;
                        flick := Flickable {
                            content-height: list.preferred-height;
                            // neue Zeile → ans Ende scrollen, wie Mountpoints scrollTo
                            property <length> filled: list.preferred-height;
                            changed filled => { self.content-y = min(0px, self.height - self.filled); }
                            list := VerticalLayout {
                                width: flick.width;
                                padding: 10px;
                                spacing: 8px;
                                for row in root.test-rows: HorizontalLayout {
                                    spacing: 8px;
                                    VerticalLayout {
                                        alignment: start;
                                        padding-top: 2px;
                                        Image {
                                            width: 12px;
                                            height: 12px;
                                            source: row.status == 0 ? @image-url("../assets/tabs/pass.png") : row.status == 1 ? @image-url("../assets/tabs/fail.png") : @image-url("../assets/tabs/skip.png");
                                            colorize: row.status == 0 ? Theme.online : row.status == 1 ? Theme.error : Theme.faint;
                                            accessible-role: image;
                                            accessible-label: row.status == 0 ? @tr("Passed") : row.status == 1 ? @tr("Failed") : @tr("Skipped");
                                        }
                                    }
                                    VerticalLayout {
                                        spacing: 2px;
                                        Text { text: row.title; font-size: 12px; color: Theme.text; }
                                        Text {
                                            width: root.column - 42px;
                                            text: row.detail;
                                            wrap: word-wrap;
                                            font-size: 10px;
                                            color: row.status == 1 ? Theme.error : Theme.faint;
                                        }
                                    }
                                }
                                if root.test-phase == 1: HorizontalLayout {
                                    spacing: 8px;
                                    VerticalLayout {
                                        alignment: center;
                                        Spinner { indeterminate: true; width: 12px; height: 12px; }
                                    }
                                    Text { text: root.test-current; font-size: 12px; color: Theme.muted; }
                                }
                            }
                        }
                        ScrollThumb { x: parent.width - self.width - 2px; view: flick.height; content: list.preferred-height; offset: flick.content-y; }
                    }
                    if root.test-phase == 2: VerticalLayout {
                        padding-top: 2px;
                        spacing: 4px;
                        Text {
                            text: root.test-summary;
                            font-size: 12px;
                            font-weight: 600;
                            color: root.test-failed ? Theme.error : Theme.text;
                        }
                        Text {
                            width: root.column;
                            wrap: word-wrap;
                            font-size: 11px;
                            color: Theme.faint;
                            text: root.test-note != "" ? root.test-note : @tr("Only anonymous data is sent: system, test results and the log with user and folder names replaced. Save the report to look at it first.");
                        }
                    }
                }
                Divider { }
                HorizontalLayout {
                    spacing: 10px;
                    CheckButton {
                        small: true;
                        text: root.test-phase == 1 ? @tr("Hide") : @tr("Back");
                        clicked => { root.back(); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    if root.test-phase == 0: CheckButton {
                        small: true;
                        text: @tr("Start self-test");
                        primary: true;
                        clicked => { root.start-selftest(); }
                    }
                    if root.test-phase == 1: VerticalLayout {
                        alignment: center;
                        Spinner { indeterminate: true; width: 16px; height: 16px; }
                    }
                    if root.test-phase == 2: CheckButton {
                        small: true;
                        text: @tr("Save report");
                        clicked => { root.save-selftest(); }
                    }
                    if root.test-phase == 2: CheckButton {
                        small: true;
                        text: root.sending ? @tr("Sending…") : @tr("Send report");
                        primary: true;
                        enabled: !root.sending;
                        clicked => { root.send-selftest(); }
                    }
                }
            }

            // Problem melden wie Mountpoints ProblemView: Felder mit Linie, ohne eigene Fläche
            if root.tab == 2 && root.page == 2: VerticalLayout {
                width: root.column;
                alignment: start;
                spacing: 12px;
                Section {
                    title: @tr("REPORT A PROBLEM");
                    spacing: 12px;
                    Text {
                        width: root.column;
                        wrap: word-wrap;
                        font-size: 12px;
                        color: Theme.muted;
                        text: @tr("What happened, and what did you expect? Ideas are welcome too. No GitHub account needed.");
                    }
                    FieldFrame {
                        height: 100px;
                        editor := Flickable {
                            x: 6px;
                            y: 6px;
                            width: parent.width - 12px;
                            height: parent.height - 12px;
                            content-height: max(self.height, description.preferred-height);
                            // beim Tippen am Ende bleiben, wenn der Text länger als das Feld wird
                            property <length> filled: description.preferred-height;
                            changed filled => { self.content-y = min(0px, self.height - self.filled); }
                            description := TextInput {
                                width: editor.width;
                                font-size: 12px;
                                color: Theme.text;
                                selection-background-color: Theme.accent.with-alpha(0.35);
                                wrap: word-wrap;
                                single-line: false;
                                text <=> root.report-text;
                                accessible-label: @tr("Description");
                            }
                        ScrollThumb { x: parent.width - self.width - 2px; view: editor.height; content: description.preferred-height; offset: editor.content-y; y: 6px + 2px + (description.preferred-height > editor.height ? -editor.content-y / (description.preferred-height - editor.height) * (editor.height - 4px - self.height) : 0px); }
                        }
                    }
                    FieldFrame {
                        height: 26px;
                        if root.report-contact == "": Text {
                            x: 8px;
                            text: @tr("Email for questions (optional)");
                            font-size: 12px;
                            color: Theme.faint;
                            vertical-alignment: center;
                            height: parent.height;
                        }
                        TextInput {
                            x: 8px;
                            width: parent.width - 16px;
                            height: parent.height;
                            font-size: 12px;
                            color: Theme.text;
                            selection-background-color: Theme.accent.with-alpha(0.35);
                            vertical-alignment: center;
                            single-line: true;
                            text <=> root.report-contact;
                            accessible-label: @tr("Email for questions (optional)");
                        }
                    }
                    SettingRow {
                        text: @tr("Attach system info and log file");
                        VerticalLayout {
                            alignment: center;
                            Switch {
                                on: root.report-attach;
                                label: @tr("Attach system info and log file");
                                toggled => { root.report-attach = !root.report-attach; }
                            }
                        }
                    }
                    Text {
                        width: root.column;
                        wrap: word-wrap;
                        font-size: 11px;
                        color: Theme.faint;
                        text: @tr("Anonymized: your user name and folder names are replaced.");
                    }
                }
                Divider { }
                HorizontalLayout {
                    spacing: 10px;
                    CheckButton {
                        small: true;
                        text: @tr("Back");
                        clicked => { root.back(); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    CheckButton {
                        small: true;
                        text: root.sending ? @tr("Sending…") : @tr("Send");
                        primary: true;
                        enabled: !root.sending && root.report-text != "";
                        clicked => { root.send-problem(); }
                    }
                }
            }

            // Über wie Mountpoints AboutView: Symbol, Name, Version, ©; Lizenz; Knöpfe; Drittanbieter
            if root.tab == 3: VerticalLayout {
                width: root.column;
                alignment: start;
                spacing: 16px;
                HorizontalLayout {
                    spacing: 14px;
                    alignment: start;
                    Image {
                        source: @image-url("../assets/icon.png");
                        width: 56px;
                        height: 56px;
                    }
                    VerticalLayout {
                        spacing: 4px;
                        alignment: center;
                        Text { text: "CineMosaic"; font-size: 15px; font-weight: 600; color: Theme.text; }
                        Text { text: @tr("Version {}", root.version); font-size: 12px; color: Theme.muted; }
                        Text { text: "© 2026 Moritz Poth"; font-size: 12px; color: Theme.muted; }
                    }
                }
                Text {
                    width: root.column;
                    wrap: word-wrap;
                    font-size: 12px;
                    color: Theme.text;
                    text: @tr("CineMosaic is free software: you can redistribute and modify it under the terms of the GNU General Public License, version 3 or later.");
                }
                Text {
                    width: root.column;
                    wrap: word-wrap;
                    font-size: 12px;
                    color: Theme.text;
                    text: @tr("It comes with ABSOLUTELY NO WARRANTY – use at your own risk.");
                }
                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;
                    CheckButton {
                        small: true;
                        text: @tr("Source code");
                        clicked => { root.open-source(); }
                    }
                    CheckButton {
                        small: true;
                        text: @tr("License");
                        clicked => { root.open-license(); }
                    }
                }
                VerticalLayout {
                    spacing: 6px;
                    Text { text: @tr("THIRD-PARTY"); font-size: 11px; font-weight: 600; letter-spacing: 1px; color: Theme.muted; }
                    Text {
                        width: root.column;
                        wrap: word-wrap;
                        font-size: 11px;
                        color: Theme.faint;
                        text: @tr("JetBrains Mono font – SIL Open Font License 1.1. Slint UI toolkit – used under the GNU GPL v3. FFmpeg – GNU GPL. Bin and AAF format knowledge from pyavb and pyaaf2 by Mark Reid (MIT).");
                    }
                    Text {
                        width: root.column;
                        wrap: word-wrap;
                        font-size: 11px;
                        color: Theme.faint;
                        text: @tr("Avid and Media Composer are trademarks of Avid Technology, Inc. CineMosaic is not affiliated with Avid.");
                    }
                }
            }
        }
    }

    // Toast wie Mountpoints .toast: unten mittig (44 über dem Rand), so breit wie der Text, gleitet von unten herein
    if root.toast-text != "": Rectangle {
        x: (root.width - self.width) / 2;
        y: root.toast-visible ? root.height - self.height - 44px : root.height;
        opacity: root.toast-visible ? 1 : 0;
        animate y, opacity { duration: 200ms; easing: ease-out; }
        width: min(measure.preferred-width, root.width - 60px) + 28px;
        // ungebrochene Breite des Textes (der Toast ist so breit wie sein Text, höchstens fast fensterbreit)
        measure := Text { visible: false; text: root.toast-text; font-size: 11px; font-weight: 600; }
        height: toast.preferred-height + 18px;
        border-radius: 8px;
        background: root.toast-ok ? Theme.online : Theme.background;
        border-width: root.toast-ok ? 0px : 1px;
        border-color: Theme.partial;
        drop-shadow-blur: 10px;
        drop-shadow-offset-y: 4px;
        drop-shadow-color: #00000040;
        toast := Text {
            width: parent.width - 28px;
            text: root.toast-text;
            wrap: word-wrap;
            font-size: 11px;
            font-weight: 600;
            color: root.toast-ok ? Theme.on-primary : Theme.text;
            accessible-role: text;
        }
    }
}

// Line patterns as small drawings; the strands in units of 1.6 px (see layout::Pattern)
component PatternPicker inherits HorizontalLayout {
    in-out property <int> current;
    callback chosen();
    spacing: 6px;
    for p[i] in [
        { name: @tr("Single"), s: [{ o: 0, w: 1 }] },
        { name: @tr("Double"), s: [{ o: 0, w: 1 }, { o: 2.5, w: 1 }] },
        { name: @tr("Thick – thin"), s: [{ o: 0, w: 3 }, { o: 4.5, w: 1 }] },
        { name: @tr("Thin – thick"), s: [{ o: 0, w: 1 }, { o: 2.5, w: 3 }] },
        { name: @tr("Thin – thick – thin"), s: [{ o: 0, w: 1 }, { o: 2.5, w: 2.5 }, { o: 6.5, w: 1 }] },
        { name: @tr("Two close, one apart"), s: [{ o: 0, w: 1 }, { o: 2.2, w: 1 }, { o: 7, w: 1 }] },
    ]: Rectangle {
        width: 46px;
        height: 30px;
        border-radius: 6px;
        border-width: i == root.current ? 2px : 1px;
        border-color: i == root.current ? Theme.accent : Theme.line;
        background: t.has-hover ? Theme.text.with-alpha(0.06) : transparent;
        accessible-role: button;
        accessible-label: p.name;
        accessible-checked: i == root.current;
        accessible-action-default => { root.current = i; root.chosen(); }
        for st in p.s: Rectangle {
            x: 7px;
            y: 8px + st.o * 1.6px;
            width: parent.width - 14px;
            height: max(1px, st.w * 1.6px);
            background: Theme.text;
        }
        t := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.current = i; root.chosen(); }
        }
    }
}

// 3 × 3 anchor points like in an image editor; the chosen one filled
component AnchorPicker inherits Rectangle {
    in property <int> current;
    callback chosen(int);
    width: 70px;
    height: 52px;
    border-radius: 6px;
    border-width: 1px;
    border-color: Theme.line;
    for i in 9: Rectangle {
        x: 8px + Math.mod(i, 3) * 21px;
        y: 6px + Math.floor(i / 3) * 15px;
        width: 12px;
        height: 10px;
        border-radius: 2px;
        border-width: 1px;
        border-color: i == root.current ? Theme.accent : Theme.muted;
        background: i == root.current ? Theme.accent : a.has-hover ? Theme.text.with-alpha(0.15) : transparent;
        accessible-role: button;
        accessible-label: [@tr("Top left"), @tr("Top centre"), @tr("Top right"), @tr("Middle left"), @tr("Centre"), @tr("Middle right"), @tr("Bottom left"), @tr("Bottom centre"), @tr("Bottom right")][i];
        accessible-checked: i == root.current;
        accessible-action-default => { root.chosen(i); }
        a := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.chosen(i); }
        }
    }
}

// Installed fonts, each name shown in its own font; ↑ / ↓ step through them, a letter jumps there
component FontList inherits Rectangle {
    in property <[string]> fonts;
    in-out property <int> current;
    callback chosen();
    callback jump(string) -> int;
    // a row clicked, or Return / Escape: the dropdown closes
    callback done();
    in property <int> rows: 7;
    property <length> row-h: 28px;
    height: self.rows * self.row-h + 2px;
    border-radius: 6px;
    border-width: 1px;
    // no blue focus frame and no blue row (user 2026-11-21): the chosen font is a quiet grey row
    border-color: Theme.line;
    clip: true;
    // keep the current font in view
    function reveal() {
        if root.current * root.row-h < -list.content-y {
            list.content-y = -root.current * root.row-h;
        } else if (root.current + 1) * root.row-h > -list.content-y + list.visible-height {
            list.content-y = -((root.current + 1) * root.row-h - list.visible-height);
        }
    }
    changed current => { root.reveal(); }
    // the list is made each time it opens: show the chosen font right away, keys go to it
    init => { root.reveal(); fs.focus(); }
    fs := FocusScope {
        key-pressed(e) => {
            if e.text == Key.Return || e.text == Key.Escape {
                root.done();
                return accept;
            }
            if e.text == Key.UpArrow {
                if root.current > 0 { root.current -= 1; root.chosen(); }
                return accept;
            }
            if e.text == Key.DownArrow {
                if root.current < root.fonts.length - 1 { root.current += 1; root.chosen(); }
                return accept;
            }
            if e.text != "" && !e.modifiers.control && !e.modifiers.meta {
                let i = root.jump(e.text);
                if i >= 0 { root.current = i; root.chosen(); }
                return accept;
            }
            reject
        }
        list := ListView {
            for f[i] in root.fonts: Rectangle {
                height: root.row-h;
                background: i == root.current ? Theme.text.with-alpha(0.14) : t.has-hover ? Theme.text.with-alpha(0.06) : transparent;
                accessible-role: list-item;
                accessible-label: f;
                accessible-checked: i == root.current;
                Text {
                    x: 10px;
                    width: parent.width - 20px;
                    text: f;
                    font-family: f;
                    font-size: 15px;
                    color: Theme.text;
                    vertical-alignment: center;
                    overflow: elide;
                }
                t := TouchArea {
                    clicked => { root.current = i; root.chosen(); root.done(); }
                }
            }
        }
    }
}

// The font as a dropdown, the name in its own look. Closed: ↑ / ↓ step through the fonts, a letter jumps to the next
// font starting with it; a click opens the list, where the same keys work and the sheet follows at once.
component FontDropdown inherits Rectangle {
    in property <[string]> fonts;
    in-out property <int> current;
    in property <string> label;
    callback chosen();
    callback jump(string) -> int;
    height: 30px;
    border-radius: 6px;
    border-width: 1px;
    border-color: fs.has-focus ? Theme.accent : Theme.line;
    background: touch.pressed ? Theme.text.with-alpha(0.12) : touch.has-hover ? Theme.text.with-alpha(0.06) : transparent;
    accessible-role: combobox;
    accessible-label: root.label;
    accessible-value: root.fonts.length > 0 ? root.fonts[root.current] : "";
    accessible-action-default => { popup.show(); }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 12px;
        spacing: 6px;
        Text {
            text: root.fonts.length > 0 ? root.fonts[root.current] : "";
            font-family: self.text;
            font-size: 15px;
            color: Theme.text;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        VerticalLayout {
            alignment: center;
            Path { width: 8px; height: 5px; commands: "M 0 0 L 4 4 L 8 0"; stroke: Theme.text; stroke-width: 1.5px; }
        }
    }
    fs := FocusScope {
        key-pressed(e) => {
            if e.text == Key.UpArrow {
                if root.current > 0 { root.current -= 1; root.chosen(); }
                return accept;
            }
            if e.text == Key.DownArrow {
                if root.current < root.fonts.length - 1 { root.current += 1; root.chosen(); }
                return accept;
            }
            if e.text == Key.Return || e.text == " " {
                popup.show();
                return accept;
            }
            if e.text != "" && e.text != Key.Tab && e.text != Key.Backtab && !e.modifiers.control && !e.modifiers.meta {
                let i = root.jump(e.text);
                if i >= 0 { root.current = i; root.chosen(); }
                return accept;
            }
            reject
        }
        touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { fs.focus(); popup.show(); }
        }
    }
    popup := PopupWindow {
        x: 0;
        y: root.height + 4px;
        width: root.width;
        height: 10 * 28px + 2px;
        close-policy: close-on-click-outside;
        Rectangle {
            width: parent.width;
            height: parent.height;
            background: Theme.sidebar;
            border-radius: 6px;
            drop-shadow-blur: 12px;
            drop-shadow-color: #00000066;
            FontList {
                width: parent.width;
                rows: 10;
                fonts: root.fonts;
                current <=> root.current;
                chosen => { root.chosen(); }
                jump(t) => { return root.jump(t); }
                done => { popup.close(); fs.focus(); }
            }
        }
    }
}

// Tabs of the side column: one segmented bar, the current segment filled
component TabStrip inherits Rectangle {
    in property <[string]> items;
    in-out property <int> current;
    height: 30px;
    border-radius: 8px;
    background: Theme.text.with-alpha(0.06);
    HorizontalLayout {
        padding: 2px;
        spacing: 2px;
        for item[i] in root.items: Rectangle {
            border-radius: 6px;
            background: i == root.current ? Theme.background : t.has-hover ? Theme.text.with-alpha(0.05) : transparent;
            drop-shadow-blur: i == root.current ? 2px : 0px;
            drop-shadow-color: #00000033;
            accessible-role: tab;
            accessible-label: item;
            accessible-checked: i == root.current;
            accessible-action-default => { root.current = i; }
            Text {
                text: item;
                font-size: 12px;
                font-weight: i == root.current ? 600 : 400;
                color: i == root.current ? Theme.text : Theme.muted;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            t := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.current = i; }
            }
        }
    }
}

// B / I: pressed look while on
component StyleToggle inherits Rectangle {
    in property <string> text;
    in property <string> label;
    in property <bool> on;
    in property <bool> bold;
    in property <bool> italic;
    callback toggled;
    width: 26px;
    height: 26px;
    border-radius: 6px;
    border-width: 1px;
    border-color: root.on ? Theme.primary : Theme.line;
    background: root.on ? Theme.primary : touch.has-hover ? Theme.text.with-alpha(0.06) : transparent;
    accessible-role: switch;
    accessible-label: root.label;
    accessible-checked: root.on;
    accessible-action-default => { root.toggled(); }
    Text {
        text: root.text;
        font-family: "Helvetica Neue";
        font-size: 13px;
        font-weight: root.bold ? 700 : 400;
        font-italic: root.italic;
        color: root.on ? Theme.on-primary : Theme.text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }
}

// Colour: five presets and a hex field. A click on a preset takes its colour; a click into the hex field opens the
// colour panel, whose colour then becomes the chosen preset; typing a hex value changes it too (Rust). The square at the right shows
// the colour Rust read.
// a text in the list of the Text tab: click opens it (only one is open), × removes it
component TextHeader inherits Rectangle {
    in property <string> title;
    in property <bool> open;
    callback clicked();
    callback removed();
    height: 30px;
    border-radius: 6px;
    background: root.open ? Theme.text.with-alpha(0.07) : t.has-hover ? Theme.text.with-alpha(0.04) : transparent;
    accessible-role: button;
    accessible-label: root.title;
    accessible-expanded: root.open;
    accessible-action-default => { root.clicked(); }
    t := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 4px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            Path {
                width: 8px;
                height: 8px;
                commands: root.open ? "M 0 2 L 4 6 L 8 2" : "M 2 0 L 6 4 L 2 8";
                stroke: Theme.text;
                stroke-width: 1.5px;
            }
        }
        Text { text: root.title; font-size: 12px; font-weight: root.open ? 600 : 400; color: Theme.text; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
        Rectangle {
            width: 22px;
            accessible-role: button;
            accessible-label: @tr("Remove {}", root.title);
            accessible-action-default => { root.removed(); }
            background: x.pressed ? Theme.text.with-alpha(0.14) : x.has-hover ? Theme.text.with-alpha(0.07) : transparent;
            border-radius: 4px;
            Text { text: "×"; font-size: 14px; color: Theme.muted; horizontal-alignment: center; vertical-alignment: center; }
            x := TouchArea { mouse-cursor: pointer; clicked => { root.removed(); } }
        }
    }
}

component ColorRow inherits HorizontalLayout {
    in property <string> text;
    in-out property <string> value;
    in property <color> shown;
    in property <bool> invalid;
    in property <[Swatch]> palette;
    // the chosen preset (-1: the colour is none of them)
    in property <int> slot;
    callback edited();
    callback swatch(int);
    callback panel();
    spacing: 6px;
    height: 30px;
    Text {
        text: root.text;
        font-size: 12px;
        horizontal-stretch: 1;
        vertical-alignment: center;
        color: Theme.text;
    }
    for sw[i] in root.palette: VerticalLayout {
        alignment: center;
        Rectangle {
            width: 18px;
            height: 18px;
            border-radius: 9px;
            background: sw.c;
            border-width: i == root.slot ? 2px : 1px;
            border-color: i == root.slot ? Theme.accent : Theme.line;
            accessible-role: button;
            accessible-label: sw.hex;
            accessible-checked: i == root.slot;
            accessible-action-default => { root.swatch(i); }
            TouchArea {
                mouse-cursor: pointer;
                clicked => { root.swatch(i); }
            }
        }
    }
    FieldFrame {
        width: 78px;
        height: 26px;
        border-color: root.invalid ? Theme.error : hex.has-focus ? Theme.accent : Theme.line;
        hex := TextInput {
            // a click into the field also opens the colour panel (Rust)
            changed has-focus => { if self.has-focus { root.panel(); } }
            x: 6px;
            width: parent.width - 30px;
            height: parent.height;
            text <=> root.value;
            font-size: 11px;
            color: Theme.text;
            vertical-alignment: center;
            single-line: true;
            accessible-label: root.text;
            edited => { root.edited(); }
        }
        Rectangle {
            x: parent.width - 20px;
            y: 6px;
            width: 14px;
            height: 14px;
            border-radius: 3px;
            background: root.shown;
            border-width: 1px;
            border-color: Theme.line;
        }
    }
}

// small text button of the zoom controls
component ZoomButton {
    in property <string> text;
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked;
    min-width: max(26px, t.preferred-width + 14px);
    height: 26px;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    Rectangle {
        border-radius: 6px;
        background: !root.enabled ? transparent : touch.pressed ? Theme.text.with-alpha(0.14) : touch.has-hover ? Theme.text.with-alpha(0.07) : transparent;
    }
    t := Text {
        text: root.text;
        font-size: root.text.character-count == 1 ? 15px : 11px;
        color: root.enabled ? Theme.text : Theme.disabled;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

export component AppWindow inherits SheetWindow {
    // the open project's name ("" = none); every project window has its own id (Rust keeps its state under it)
    in property <string> project-name;
    in property <int> win-id;
    // files from the Finder are being dragged over the window (Rust, winit events)
    in property <bool> drop-hover;
    title: root.project-name == "" ? "CineMosaic" : root.project-name + " – CineMosaic";
    // resizable; never smaller than the side column needs (user 2026-11-20)
    min-width: root.smallest-width;
    min-height: root.smallest-height;
    out property <length> smallest-width: 1000px;
    // what the side column needs; Rust lowers it to the screen on small displays
    in-out property <length> smallest-height: 820px;
    preferred-width: 1573px;
    preferred-height: 920px;
    // app menu item, translated (Rust puts it into the macOS app menu)
    out property <string> txt-settings-menu: @tr("Settings…");

    // source: 0 master file + cut list, 1 Media Composer bin
    in-out property <int> mode;
    in property <string> bin-name;
    // "All sequences", then the bin's sequences; `checked` = ticked in the menu
    in property <[MenuChoice]> sequences;
    in property <string> sequence-label;
    in property <[VolumeRow]> volumes;
    // master mode: the files chosen (a master and the cut list with the same name belong together)
    in property <[MasterRow]> masters-shown;
    in property <[string]> list-names;
    callback remove-master(int);
    callback remove-list(int);
    // a master without cut list: its cuts can be found in the picture
    in property <bool> can-detect;
    // timecode typing in the fields of master i (its own frame rate)
    pure callback tc-edit(int, TcState, string, bool) -> TcState;
    callback tc-paste(int, TcState) -> TcState;
    pure callback tc-parts(string) -> [string];
    // master i: the film between these master timecodes (empty: from the start / to the end), titles stay out
    callback film-changed(int, string, string);
    callback detect-cuts();
    in property <string> source-info;
    in property <string> source-error;
    // 0 nothing grabbed yet, 1 grabbing, 2 stills ready
    in property <int> state;
    in property <float> progress;
    in property <string> work-text;
    in property <string> time-left;
    in property <bool> paused;
    in property <bool> can-grab;
    // stills the sheet needs that were not grabbed yet (the sheet changed after grabbing)
    in property <int> missing;
    // sheet (index into the paper list: 0 custom, 1–7 DIN A0..A6, 8–14 social media sizes in px); the list fills width × height, editing them picks the
    // matching size or Custom (Rust)
    in-out property <int> paper: 5;
    // paper size in px instead of mm (margin, gap, frame line and headline move are always px of the sheet); Rust converts the fields on a switch
    in-out property <bool> px-units;
    out property <string> unit: root.px-units ? "px" : "mm";
    callback paper-chosen(int);
    // Custom, DIN, social media (section titles: `checked`), filled by Rust; the button shows `paper-label`
    in property <[MenuChoice]> paper-menu;
    in property <string> paper-label;
    callback orientation-chosen(bool);
    callback unit-chosen(bool);
    callback size-edited();
    // picture format: 0 full frame (no crop), 1.. the formats in layout::PICTURE, then custom; width : height
    // always shown in one field (the menu fills it, typing picks the matching format – Rust)
    in-out property <int> picture: 0;
    in-out property <string> aspect: "16:9";
    in property <[MenuChoice]> picture-menu;
    // the chosen format as the button shows it: "9:16", not the platforms
    in property <string> picture-label;
    callback picture-chosen(int);
    callback picture-edited();
    in-out property <bool> landscape: true;
    // side column tab: 0 source, 1 sheet, 2 design
    in-out property <int> side-tab;
    changed side-tab => { side-flick.content-y = 0; }
    // crop marks: trim area in the picture format
    in-out property <bool> trim;
    // frame line and headline; colours as "#rrggbb", the swatch shows what Rust read
    in-out property <bool> line-on;
    // a grid in percent of the page over the preview on the Headline tab (only shown, never exported)
    in-out property <bool> head-grid;
    in-out property <string> head-grid-step: "10";
    property <int> grid-step: root.head-grid-step.is-float() ? clamp(Math.round(root.head-grid-step.to-float()), 1, 50) : 10;
    // the middle of the headline in % of the trim area, and whether it lies on a grid line (within half a pixel of
    // the sheet): its ticks turn green
    property <float> head-cx: (root.head-bx + root.head-bw / 2 - root.trim-x) / root.trim-w * 100;
    property <float> head-cy: (root.head-by + root.head-bh / 2 - root.trim-y) / root.trim-h * 100;
    property <bool> on-grid-x: root.head-grid && Math.abs(root.head-cx - Math.round(root.head-cx / root.grid-step) * root.grid-step) / 100 * root.trim-w * root.page-px <= 0.6;
    property <bool> on-grid-y: root.head-grid && Math.abs(root.head-cy - Math.round(root.head-cy / root.grid-step) * root.grid-step) / 100 * root.trim-h * root.page-px / root.page-aspect <= 0.6;
    // px of the sheet; the defaults are the old 1 mm and 6 mm at 300 dpi
    in-out property <string> line-width: "12";
    in-out property <string> line-inset: "71";
    in-out property <string> line-color: "#000000";
    in property <color> line-swatch: black;
    in-out property <int> line-pattern;
    in-out property <string> headline;
    // headline anchor 0–8 (rows top / middle / bottom × left / centre / right) and its move in px of the sheet
    in property <int> head-anchor: 1;
    in-out property <string> head-dx: "0";
    in-out property <string> head-dy: "94";
    // space the stills keep from the headline, px of the sheet (24 px = the old 2 mm at 300 dpi); over the stills
    // they can flow around it
    in-out property <string> head-pad-t: "24";
    in-out property <string> head-pad-r: "24";
    in-out property <string> head-pad-b: "24";
    in-out property <string> head-pad-l: "24";
    in-out property <bool> head-wrap;
    // where Rust drew the headline and the trim area (the whole page without crop marks), as fractions of the page,
    // and the page width in px of the sheet (dragging, grid hits)
    in property <float> head-bx;
    in property <float> head-by;
    in property <float> head-bw;
    in property <float> head-bh;
    in property <float> page-px: 3508;
    in property <float> trim-x: 0;
    in property <float> trim-y: 0;
    in property <float> trim-w: 1;
    in property <float> trim-h: 1;
    callback anchor-chosen(int);
    callback jump-font(string) -> int;
    in property <[string]> fonts;
    in-out property <int> font;
    in-out property <string> head-size: "24";
    in-out property <bool> head-bold;
    in-out property <bool> head-italic;
    in-out property <string> head-color: "#000000";
    in property <color> head-swatch: black;
    // colour presets (Rust: settings, the same in every window) and the chosen one; 0 frame line, 1 headline
    in property <[Swatch]> line-palette;
    in property <[Swatch]> head-palette;
    in-out property <int> line-slot;
    in-out property <int> head-slot;
    // photomosaic (Sheet tab): the stills rebuild a main picture (a file, or a still clicked in the preview)
    in-out property <bool> mosaic-on;
    in-out property <string> mosaic-cols: "40";
    in-out property <string> mosaic-frames: "1";
    in-out property <string> mosaic-repeat: "3";
    in-out property <string> mosaic-tint: "40";
    in-out property <string> mosaic-overlay: "10";
    in property <string> mosaic-name;
    callback pick-mosaic-image();
    callback page-clicked(float, float);
    // sheet background (2): the page behind the stills
    in-out property <string> bg-color: "#ffffff";
    in property <color> bg-swatch: white;
    in property <[Swatch]> bg-palette;
    in-out property <int> bg-slot;
    // text elements (Text tab): one header per text, the open one is edited in the head-* fields
    in property <[string]> text-titles;
    in-out property <int> text-open;
    in property <[TextBox]> text-boxes;
    callback text-open-at(int);
    callback text-add();
    callback text-remove(int);
    // lines of the open text: 0 left, 1 centred, 2 right
    in-out property <int> head-lines: 1;
    // drop shadow of the open text, as Photoshop's layer style (defaults as there: Multiply, black, 75 %, 120°)
    in-out property <bool> sh-on;
    in-out property <int> sh-blend: 2;
    in-out property <string> sh-color: "#000000";
    in property <color> sh-swatch: black;
    in-out property <int> sh-slot;
    in-out property <string> sh-opacity: "75";
    in-out property <string> sh-angle: "120";
    in-out property <bool> sh-global: true;
    // Use Global Light: one angle for every text that has it on (kept with the sheet)
    in-out property <string> global-angle: "120";
    in-out property <string> sh-distance: "12";
    in-out property <string> sh-spread: "0";
    in-out property <string> sh-size: "18";
    in-out property <int> sh-contour;
    in-out property <bool> sh-aa;
    in-out property <string> sh-noise: "0";
    in-out property <bool> sh-knock: true;
    callback color-swatch(int, int);
    callback color-panel(int);
    callback color-typed(int);

    in-out property <string> custom-w: "297";
    in-out property <string> custom-h: "210";
    in-out property <string> dpi: "300";
    // px of the sheet; the defaults are the old 10 mm and 3 mm at 300 dpi
    in-out property <string> margin: "118";
    in-out property <string> gap: "35";
    in-out property <bool> auto-cols: true;
    in-out property <string> cols: "4";
    // names of the fields Rust could not read ("dpi", "margin", …)
    in property <string> invalid;
    in property <string> sheet-info;
    // preview
    in property <image> preview;
    // zoom of the preview: 1 = the whole page fits; pan = offset of the page centre from the centre of the desk
    in-out property <float> zoom: 1;
    in-out property <length> pan-x;
    in-out property <length> pan-y;
    // Rust renders a sharper preview once the zoom stops changing
    callback zoom-changed(float);
    in property <float> page-aspect: 210 / 297;
    // presets (kept inside the app): names, the chosen one (-1 none), 0 menu / 1 naming a new one / 2 renaming /
    // 3 asking before delete, the name being typed, a line after a change
    in property <[string]> presets;
    in-out property <int> preset: -1;
    in-out property <int> preset-edit;
    in-out property <string> preset-draft;
    in-out property <string> preset-status;
    callback preset-chosen(int);
    callback preset-update();
    callback preset-commit();
    callback preset-delete();
    // export
    in-out property <int> export-format: 3;
    in property <bool> exporting;
    in property <string> export-status;
    in property <bool> can-reveal;

    callback pick-master();
    callback mode-chosen(int);
    callback pick-bin();
    callback toggle-sequence(int);
    callback toggle-volume(int);
    callback pick-list();
    callback grab();
    callback pause(bool);
    callback cancel();
    callback sheet-changed();
    callback export();
    callback reveal();

    HorizontalLayout {
        // side column
        Rectangle {
            width: Metrics.side-width;
            background: Theme.sidebar;
            VerticalLayout {
                padding: 28px;
                padding-top: 22px;
                spacing: 6px;
                Headline { }
                TabStrip {
                    items: [@tr("Source"), @tr("Sheet"), @tr("Frame line"), @tr("Text")];
                    current <=> root.side-tab;
                }
                Rectangle { height: 6px; }

                // the tab scrolls when the window is too low for it: nothing disappears (user 2026-11-22); no drag
                // scrolling, so the fields can still be dragged – wheel and trackpad scroll
                Rectangle {
                    vertical-stretch: 1;
                    side-flick := Flickable {
                        interactive: false;
                        content-height: tabs.preferred-height;
                        tabs := VerticalLayout {
                            x: 0;
                            width: side-flick.width;
                            alignment: start;
                            // alignment start: free space goes below, never between the rows
                            if root.side-tab == 0: VerticalLayout {
                                spacing: 6px;
                                alignment: start;
                                vertical-stretch: 1;
                                Row {
                                    text: @tr("Source");
                                    Dropdown {
                                        label: @tr("Source");
                                        items: [@tr("Master file + cut list"), @tr("Media Composer bin")];
                                        current: root.mode;
                                        enabled: root.state != 1;
                                        selected(i) => { root.mode = i; root.mode-chosen(i); }
                                    }
                                }
                                if root.mode == 0: VerticalLayout {
                                    spacing: 6px;
                                    Row {
                                        text: @tr("Master files");
                                        CheckButton { text: @tr("Add…"); small: true; enabled: root.state != 1; clicked => { root.pick-master(); } }
                                    }
                                    for m[i] in root.masters-shown: VerticalLayout {
                                        FileRow { text: m.name; enabled: root.state != 1; removed => { root.remove-master(i); } }
                                        // its own film range (user 2026-11-23)
                                        HorizontalLayout {
                                            padding-top: 2px;
                                            padding-bottom: 6px;
                                            spacing: 6px;
                                            Text { text: @tr("Start"); font-size: 11px; color: Theme.muted; vertical-alignment: center; }
                                            from := TcField {
                                                text: m.from; label: @tr("Start") + " " + m.name; enabled: root.state != 1;
                                                edit(s, k, mt) => { root.tc-edit(i, s, k, mt) } paste(s) => { root.tc-paste(i, s) } parts(t) => { root.tc-parts(t) }
                                                done => { root.film-changed(i, from.text, to.text); }
                                            }
                                            Rectangle { horizontal-stretch: 1; }
                                            Text { text: @tr("End"); font-size: 11px; color: Theme.muted; vertical-alignment: center; }
                                            to := TcField {
                                                text: m.to; label: @tr("End") + " " + m.name; enabled: root.state != 1;
                                                edit(s, k, mt) => { root.tc-edit(i, s, k, mt) } paste(s) => { root.tc-paste(i, s) } parts(t) => { root.tc-parts(t) }
                                                done => { root.film-changed(i, from.text, to.text); }
                                            }
                                        }
                                    }
                                    Row {
                                        text: @tr("Cut lists");
                                        CheckButton { text: @tr("Add…"); small: true; enabled: root.state != 1; clicked => { root.pick-list(); } }
                                    }
                                    for name[i] in root.list-names: FileRow { text: name; enabled: root.state != 1; removed => { root.remove-list(i); } }
                                    Para { text: @tr("A cut list belongs to the master file with the same name – Reel1.mov and Reel1.xml."); }
                                    // always there; usable while a master has neither a cut list nor detected cuts
                                    VerticalLayout {
                                        spacing: 6px;
                                        HorizontalLayout {
                                            padding-top: 8px;
                                            padding-bottom: 2px;
                                            alignment: start;
                                            CheckButton { text: @tr("Detect cuts"); small: true; enabled: root.state != 1 && root.can-detect; clicked => { root.detect-cuts(); } }
                                        }
                                        Para { text: @tr("No cut list? CineMosaic can find the cuts in the picture of the master files. This can take long: the whole film is analysed."); }
                                        Para { text: @tr("Start and end under each master file: its timecode, e.g. 01:01:30:00, to leave out opening and end titles; the shots follow at once. Click hours, minutes, seconds or frames to change them, double-click for the whole timecode. Empty: from the start, to the end."); }
                                    }
                                }
                                if root.mode == 1: VerticalLayout {
                                    spacing: 6px;
                                    Row {
                                        text: @tr("Bin");
                                        CheckButton { text: @tr("Choose…"); small: true; enabled: root.state != 1; clicked => { root.pick-bin(); } }
                                    }
                                    if root.bin-name != "": Para { text: root.bin-name; color: Theme.muted; }
                                    if root.sequences.length > 0: Row {
                                        text: @tr("Sequence");
                                        // All sequences, or one or several with a tick
                                        CheckDropdown {
                                            label: @tr("Sequence");
                                            entries: root.sequences;
                                            text: root.sequence-label;
                                            enabled: root.state != 1;
                                            selected(i) => { root.toggle-sequence(i); }
                                        }
                                    }
                                    Text { text: @tr("Volumes with Avid MediaFiles"); font-size: 12px; color: Theme.text; height: 24px; vertical-alignment: center; }
                                    if root.volumes.length == 0: Para { text: @tr("No volume with an Avid MediaFiles folder is connected."); }
                                    // shortcut: a plain scroll area without a thumb; enough for the usual handful of volumes
                                    Flickable {
                                        height: min(root.volumes.length * 28px, 112px);
                                        content-height: root.volumes.length * 28px;
                                        VerticalLayout {
                                            for v[i] in root.volumes: HorizontalLayout {
                                                height: 28px;
                                                spacing: 10px;
                                                Text { text: v.name; font-size: 12px; color: Theme.muted; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                                                VerticalLayout {
                                                    alignment: center;
                                                    Switch { on: v.on; label: v.name; enabled: root.state != 1; toggled => { root.toggle-volume(i); } }
                                                }
                                            }
                                        }
                                    }
                                }
                                if root.source-error != "": Para { text: root.source-error; color: Theme.error; }
                                if root.source-info != "": Para { text: root.source-info; }
                                if root.state != 1: HorizontalLayout {
                                    padding-top: 12px;
                                    alignment: start;
                                    CheckButton {
                                        text: root.state == 2 && root.missing > 0 ? @tr("Grab {} missing stills", root.missing)
                                            : root.state == 2 ? @tr("Grab stills again") : @tr("Grab stills");
                                        primary: root.state != 2 || root.missing > 0;
                                        enabled: root.can-grab;
                                        clicked => { root.grab(); }
                                    }
                                }
                                if root.state == 1: VerticalLayout {
                                    padding-top: 4px;
                                    spacing: 6px;
                                    ProgressBar { value: root.progress; }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text { text: root.work-text; font-size: 11px; color: Theme.muted; overflow: elide; horizontal-stretch: 1; }
                                        Text { text: root.paused ? @tr("Paused") : root.time-left; font-size: 11px; color: Theme.muted; horizontal-stretch: 0; }
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: end;
                                        CheckButton { text: root.paused ? @tr("Resume") : @tr("Pause"); small: true; clicked => { root.pause(!root.paused); } }
                                        CheckButton { text: @tr("Cancel"); small: true; clicked => { root.cancel(); } }
                                    }
                                }
                            }
                            // alignment start: free space goes below, never between the rows
                            if root.side-tab == 1: VerticalLayout {
                                spacing: 6px;
                                alignment: start;
                                vertical-stretch: 1;
                                Row {
                                    text: @tr("Picture format");
                                    SectionDropdown {
                                        label: @tr("Picture format");
                                        entries: root.picture-menu;
                                        text: root.picture-label;
                                        // menu: 0 Full frame, 1–9 film formats, 10 Custom
                                        current: root.picture;
                                        selected(i) => { root.picture-chosen(i); }
                                    }
                                }
                                Row {
                                    text: @tr("Width : height");
                                    // one field like the old Custom: "2.39:1", "9:16", "21:9" or just "2.39" (typing only)
                                    NumberField { text <=> root.aspect; scrub: 0; unit: ""; label: @tr("Width : height"); invalid: root.invalid == "aspect"; edited => { root.picture-edited(); } }
                                }
                                if root.picture != 0: Para { text: @tr("Black bars outside this format are cut off (top and bottom or left and right)."); }
                                // a little room above paper and margin: the sheet in three groups
                                Rectangle { height: 8px; }
                                Row {
                                    text: @tr("Paper");
                                    SectionDropdown {
                                        label: @tr("Paper");
                                        entries: root.paper-menu;
                                        text: root.paper-label;
                                        // menu: 0 Custom, 1 heading, 2–8 DIN A0–A6, 9 heading, 10–16 social media sizes
                                        current: root.paper == 0 ? 0 : root.paper <= 7 ? root.paper + 1 : root.paper + 2;
                                        selected(i) => { root.paper-chosen(i == 0 ? 0 : i <= 8 ? i - 1 : i - 2); }
                                    }
                                }
                                Row {
                                    text: @tr("Unit");
                                    Dropdown {
                                        label: @tr("Unit");
                                        items: ["mm", @tr("Pixels")];
                                        current: root.px-units ? 1 : 0;
                                        selected(i) => { root.unit-chosen(i == 1); }
                                    }
                                }
                                Row {
                                    text: @tr("Width × height");
                                    NumberField { text <=> root.custom-w; scrub: root.px-units ? 4 : 1; step: 1; minimum: 10; unit: root.unit; label: @tr("Width"); invalid: root.invalid == "width"; edited => { root.size-edited(); } }
                                    NumberField { text <=> root.custom-h; scrub: root.px-units ? 4 : 1; step: 1; minimum: 10; unit: root.unit; label: @tr("Height"); invalid: root.invalid == "height"; edited => { root.size-edited(); } }
                                }
                                Row {
                                    text: @tr("Orientation");
                                    Dropdown {
                                        label: @tr("Orientation");
                                        items: [@tr("Portrait"), @tr("Landscape")];
                                        current: root.landscape ? 1 : 0;
                                        selected(i) => { root.orientation-chosen(i == 1); }
                                    }
                                }
                                Row {
                                    text: @tr("Resolution");
                                    NumberField { text <=> root.dpi; scrub: 1; step: 1; minimum: 10; unit: "dpi"; label: @tr("Resolution"); invalid: root.invalid == "dpi"; edited => { root.size-edited(); } }
                                }
                                Rectangle { height: 8px; }
                                Row {
                                    text: @tr("Margin");
                                    NumberField {
                                        text <=> root.margin; unit: "px"; label: @tr("Margin"); invalid: root.invalid == "margin";
                                        scrub: 1; step: 1; minimum: -99999;
                                        edited => { root.sheet-changed(); }
                                    }
                                }
                                Row {
                                    text: @tr("Gap between stills");
                                    NumberField {
                                        text <=> root.gap; unit: "px"; label: @tr("Gap between stills"); invalid: root.invalid == "gap";
                                        scrub: 0.5; step: 1;
                                        edited => { root.sheet-changed(); }
                                    }
                                }
                                ColorRow {
                                    text: @tr("Background"); value <=> root.bg-color; shown: root.bg-swatch; invalid: root.invalid == "bg-color";
                                    palette: root.bg-palette; slot: root.bg-slot;
                                    edited => { root.color-typed(2); root.sheet-changed(); }
                                    swatch(i) => { root.color-swatch(2, i); }
                                    panel => { root.color-panel(2); }
                                }
                                Para { text: @tr("Drag left or right in a field to change the value; click to type it."); }
                                Row {
                                    text: @tr("Columns automatic");
                                    VerticalLayout {
                                        alignment: center;
                                        Switch { on: root.auto-cols; label: @tr("Columns automatic"); toggled => { root.auto-cols = !root.auto-cols; root.sheet-changed(); } }
                                    }
                                }
                                if !root.auto-cols: Row {
                                    text: @tr("Columns");
                                    NumberField { text <=> root.cols; scrub: 0.1; step: 1; minimum: 1; unit: ""; label: @tr("Columns"); invalid: root.invalid == "columns"; edited => { root.sheet-changed(); } }
                                }
                                Row {
                                    text: @tr("Crop marks");
                                    VerticalLayout {
                                        alignment: center;
                                        Switch { on: root.trim; label: @tr("Crop marks"); toggled => { root.trim = !root.trim; root.sheet-changed(); } }
                                    }
                                }
                                if root.trim: Para { text: @tr("The sheet is laid out in an area of the picture format inside the paper, with crop marks at its corners to cut it out."); }
                                Rectangle { height: 8px; }
                                Row {
                                    text: @tr("Layout");
                                    Dropdown {
                                        label: @tr("Layout");
                                        items: [@tr("Shot after shot"), @tr("Photomosaic")];
                                        current: root.mosaic-on ? 1 : 0;
                                        selected(i) => { root.mosaic-on = i == 1; root.sheet-changed(); }
                                    }
                                }
                                if root.mosaic-on: VerticalLayout {
                                    spacing: 6px;
                                    Row {
                                        text: @tr("Main picture");
                                        CheckButton { text: @tr("Choose…"); small: true; clicked => { root.pick-mosaic-image(); } }
                                    }
                                    Para { text: root.mosaic-name != "" ? root.mosaic-name : @tr("None yet: choose a picture, drop one onto the window, or click a still in the preview."); color: root.mosaic-name != "" ? Theme.text : Theme.muted; }
                                    Row {
                                        text: @tr("Tiles across");
                                        NumberField { text <=> root.mosaic-cols; scrub: 0.2; step: 1; minimum: 4; maximum: 200; unit: ""; label: @tr("Tiles across"); invalid: root.invalid == "mosaic-cols"; edited => { root.sheet-changed(); } }
                                    }
                                    Row {
                                        text: @tr("Stills per shot");
                                        NumberField { text <=> root.mosaic-frames; scrub: 0.05; step: 1; minimum: 1; maximum: 5; unit: ""; label: @tr("Stills per shot"); invalid: root.invalid == "mosaic-frames"; edited => { root.sheet-changed(); } }
                                    }
                                    Row {
                                        text: @tr("Repeat at the earliest after");
                                        NumberField { text <=> root.mosaic-repeat; scrub: 0.05; step: 1; minimum: 0; maximum: 20; unit: @tr("tiles"); label: @tr("Repeat at the earliest after"); invalid: root.invalid == "mosaic-repeat"; edited => { root.sheet-changed(); } }
                                    }
                                    Row {
                                        text: @tr("Colour match");
                                        NumberField { text <=> root.mosaic-tint; scrub: 0.5; step: 1; minimum: 0; maximum: 100; unit: "%"; label: @tr("Colour match"); invalid: root.invalid == "mosaic-tint"; edited => { root.sheet-changed(); } }
                                    }
                                    Row {
                                        text: @tr("Blend in main picture");
                                        NumberField { text <=> root.mosaic-overlay; scrub: 0.5; step: 1; minimum: 0; maximum: 100; unit: "%"; label: @tr("Blend in main picture"); invalid: root.invalid == "mosaic-overlay"; edited => { root.sheet-changed(); } }
                                    }
                                    Para { text: @tr("Every tile gets the still whose colours fit it best; a still comes back only that many tiles away. More stills per shot give more colours to choose from (Grab missing stills fetches them). Colour match tints each tile towards its place in the main picture, Blend in lays the main picture over everything – a little of both makes the picture clear."); }
                                }
                                Para { text: root.sheet-info; }
                            }
                            // alignment start: free space goes below, never between the rows
                            if root.side-tab == 2: VerticalLayout {
                                spacing: 6px;
                                alignment: start;
                                vertical-stretch: 1;
                                Row {
                                    text: @tr("Frame line");
                                    VerticalLayout {
                                        alignment: center;
                                        Switch { on: root.line-on; label: @tr("Frame line"); toggled => { root.line-on = !root.line-on; root.sheet-changed(); } }
                                    }
                                }
                                VerticalLayout {
                                    spacing: 6px;
                                    Text { text: @tr("Pattern"); font-size: 12px; color: Theme.text; height: 22px; vertical-alignment: center; }
                                    PatternPicker { current <=> root.line-pattern; chosen => { root.sheet-changed(); } }
                                    Para { text: @tr("Drag left or right in a field to change the value; click to type it."); }
                                    Row {
                                        text: @tr("Thickness");
                                        NumberField { text <=> root.line-width; scrub: 0.2; step: 1; minimum: 1; unit: "px"; label: @tr("Thickness"); invalid: root.invalid == "line-width"; edited => { root.sheet-changed(); } }
                                    }
                                    Row {
                                        text: @tr("Distance from the edge");
                                        NumberField {
                                            text <=> root.line-inset; scrub: 1; step: 1; unit: "px"; label: @tr("Distance from the edge"); invalid: root.invalid == "line-inset";
                                            edited => { root.sheet-changed(); }
                                        }
                                    }
                                    ColorRow {
                                        text: @tr("Colour"); value <=> root.line-color; shown: root.line-swatch; invalid: root.invalid == "line-color";
                                        palette: root.line-palette; slot: root.line-slot;
                                        edited => { root.color-typed(0); root.sheet-changed(); }
                                        swatch(i) => { root.color-swatch(0, i); }
                            panel => { root.color-panel(0); }
                                    }
                                }
                            }
                            if root.side-tab == 3: VerticalLayout {
                                spacing: 6px;
                                alignment: start;
                                vertical-stretch: 1;
                                // the texts: one header each, only the open one shows its fields (user 2026-11-23)
                                for title[ti] in root.text-titles: VerticalLayout {
                                    spacing: 6px;
                                    TextHeader {
                                        title: title != "" ? title : @tr("Text {}", ti + 1);
                                        open: ti == root.text-open;
                                        clicked => { root.text-open-at(ti); }
                                        removed => { root.text-remove(ti); }
                                    }
                                    if ti == root.text-open: VerticalLayout {
                                        spacing: 6px;
                                        FieldFrame {
                                            height: max(26px, head-input.preferred-height + 12px);
                                            border-color: head-input.has-focus ? Theme.accent : Theme.line;
                                            if root.headline == "": Text {
                                                x: 8px;
                                                y: 6px;
                                                text: @tr("Text – Return starts a new line");
                                                font-size: 12px;
                                                color: Theme.faint;
                                            }
                                            head-input := TextInput {
                                                x: 8px;
                                                y: 6px;
                                                width: parent.width - 16px;
                                                height: parent.height - 12px;
                                                text <=> root.headline;
                                                font-size: 12px;
                                                color: Theme.text;
                                                single-line: false;
                                                accessible-label: @tr("Text");
                                                edited => { root.sheet-changed(); }
                                            }
                                        }
                                        VerticalLayout {
                                            spacing: 6px;
                                            Row {
                                                text: @tr("Font");
                                                FontDropdown {
                                                    width: 240px;
                                                    label: @tr("Font");
                                                    fonts: root.fonts;
                                                    current <=> root.font;
                                                    chosen => { root.sheet-changed(); }
                                                    jump(t) => { return root.jump-font(t); }
                                                }
                                            }
                                            Row {
                                                text: @tr("Size");
                                                StyleToggle { text: "B"; bold: true; label: @tr("Bold"); on: root.head-bold; toggled => { root.head-bold = !root.head-bold; root.sheet-changed(); } }
                                                StyleToggle { text: "I"; italic: true; label: @tr("Italic"); on: root.head-italic; toggled => { root.head-italic = !root.head-italic; root.sheet-changed(); } }
                                                NumberField { text <=> root.head-size; scrub: 0.5; step: 1; minimum: 2; unit: "pt"; label: @tr("Size"); invalid: root.invalid == "head-size"; edited => { root.sheet-changed(); } }
                                            }
                                            Row {
                                                text: @tr("Lines");
                                                Dropdown {
                                                    label: @tr("Lines");
                                                    items: [@tr("Left"), @tr("Centred"), @tr("Right")];
                                                    current: root.head-lines;
                                                    selected(i) => { root.head-lines = i; root.sheet-changed(); }
                                                }
                                            }
                                            ColorRow {
                                                text: @tr("Colour"); value <=> root.head-color; shown: root.head-swatch; invalid: root.invalid == "head-color";
                                                palette: root.head-palette; slot: root.head-slot;
                                                edited => { root.color-typed(1); root.sheet-changed(); }
                                                swatch(i) => { root.color-swatch(1, i); }
                                    panel => { root.color-panel(1); }
                                            }
                                            HorizontalLayout {
                                                spacing: 10px;
                                                VerticalLayout {
                                                    spacing: 4px;
                                                    Text { text: @tr("Anchor"); font-size: 12px; color: Theme.text; }
                                                    AnchorPicker { current: root.head-anchor; chosen(i) => { root.anchor-chosen(i); } }
                                                }
                                                Rectangle { horizontal-stretch: 1; }
                                                VerticalLayout {
                                                    spacing: 6px;
                                                    alignment: end;
                                                    HorizontalLayout {
                                                        spacing: 6px;
                                                        Text { text: "X"; font-size: 12px; color: Theme.muted; vertical-alignment: center; }
                                                        NumberField { text <=> root.head-dx; scrub: 2; step: 1; minimum: -99999; unit: "px"; label: @tr("Move right"); invalid: root.invalid == "head-dx"; edited => { root.sheet-changed(); } }
                                                    }
                                                    HorizontalLayout {
                                                        spacing: 6px;
                                                        Text { text: "Y"; font-size: 12px; color: Theme.muted; vertical-alignment: center; }
                                                        NumberField { text <=> root.head-dy; scrub: 2; step: 1; minimum: -99999; unit: "px"; label: @tr("Move down"); invalid: root.invalid == "head-dy"; edited => { root.sheet-changed(); } }
                                                    }
                                                }
                                            }
                                            Para { text: @tr("Drag left or right in a field to change the value; click to type it."); }
                                            Para { text: @tr("The anchor is the point of the sheet the text hangs at; X and Y move it from there. You can also drag it in the preview; a click on another text there opens that one. Where a text covers the frame line, the line breaks."); }
                                            Rectangle { height: 8px; }
                                            Row {
                                                text: @tr("Space above · below");
                                                NumberField { width: 78px; text <=> root.head-pad-t; scrub: 0.5; step: 1; unit: "px"; label: @tr("Space above"); invalid: root.invalid == "head-pad-t"; edited => { root.sheet-changed(); } }
                                                NumberField { width: 78px; text <=> root.head-pad-b; scrub: 0.5; step: 1; unit: "px"; label: @tr("Space below"); invalid: root.invalid == "head-pad-b"; edited => { root.sheet-changed(); } }
                                            }
                                            Row {
                                                text: @tr("Space left · right");
                                                NumberField { width: 78px; text <=> root.head-pad-l; scrub: 0.5; step: 1; unit: "px"; label: @tr("Space left"); invalid: root.invalid == "head-pad-l"; edited => { root.sheet-changed(); } }
                                                NumberField { width: 78px; text <=> root.head-pad-r; scrub: 0.5; step: 1; unit: "px"; label: @tr("Space right"); invalid: root.invalid == "head-pad-r"; edited => { root.sheet-changed(); } }
                                            }
                                            Row {
                                                text: @tr("Stills around the text");
                                                VerticalLayout {
                                                    alignment: center;
                                                    Switch { on: root.head-wrap; label: @tr("Stills around the text"); toggled => { root.head-wrap = !root.head-wrap; root.sheet-changed(); } }
                                                }
                                            }
                                            Para { text: @tr("The space is what the stills keep from the text. At the top or bottom they stay below or above it; over the stills they lie under it – or, with Stills around the text, leave its place free and go on in the next cells."); }
                                            Rectangle { height: 8px; }
                                            Row {
                                                text: @tr("Drop shadow");
                                                VerticalLayout {
                                                    alignment: center;
                                                    Switch { on: root.sh-on; label: @tr("Drop shadow"); toggled => { root.sh-on = !root.sh-on; root.sheet-changed(); } }
                                                }
                                            }
                                            if root.sh-on: VerticalLayout {
                                                spacing: 6px;
                                                Row {
                                                    text: @tr("Blend mode");
                                                    Dropdown {
                                                        label: @tr("Blend mode");
                                                        items: [@tr("Normal"), @tr("Darken"), @tr("Multiply"), @tr("Color Burn"), @tr("Linear Burn"), @tr("Lighten"), @tr("Screen"), @tr("Color Dodge"), @tr("Linear Dodge (Add)"), @tr("Overlay"), @tr("Soft Light"), @tr("Hard Light"), @tr("Difference"), @tr("Exclusion")];
                                                        current: root.sh-blend;
                                                        selected(i) => { root.sh-blend = i; root.sheet-changed(); }
                                                    }
                                                }
                                                ColorRow {
                                                    text: @tr("Colour"); value <=> root.sh-color; shown: root.sh-swatch; invalid: root.invalid == "sh-color";
                                                    palette: root.head-palette; slot: root.sh-slot;
                                                    edited => { root.color-typed(3); root.sheet-changed(); }
                                                    swatch(i) => { root.color-swatch(3, i); }
                                                    panel => { root.color-panel(3); }
                                                }
                                                Row {
                                                    text: @tr("Opacity");
                                                    NumberField { text <=> root.sh-opacity; scrub: 0.5; step: 1; minimum: 0; maximum: 100; unit: "%"; label: @tr("Opacity"); invalid: root.invalid == "sh-opacity"; edited => { root.sheet-changed(); } }
                                                }
                                                Row {
                                                    text: @tr("Angle");
                                                    if root.sh-global: NumberField { text <=> root.global-angle; scrub: 1; step: 1; minimum: -360; maximum: 360; unit: "°"; label: @tr("Angle"); invalid: root.invalid == "global-angle"; edited => { root.sheet-changed(); } }
                                                    if !root.sh-global: NumberField { text <=> root.sh-angle; scrub: 1; step: 1; minimum: -360; maximum: 360; unit: "°"; label: @tr("Angle"); invalid: root.invalid == "sh-angle"; edited => { root.sheet-changed(); } }
                                                }
                                                Row {
                                                    text: @tr("Use global light");
                                                    VerticalLayout {
                                                        alignment: center;
                                                        Switch { on: root.sh-global; label: @tr("Use global light"); toggled => { root.sh-global = !root.sh-global; root.sheet-changed(); } }
                                                    }
                                                }
                                                Row {
                                                    text: @tr("Distance");
                                                    NumberField { text <=> root.sh-distance; scrub: 0.5; step: 1; minimum: 0; unit: "px"; label: @tr("Distance"); invalid: root.invalid == "sh-distance"; edited => { root.sheet-changed(); } }
                                                }
                                                Row {
                                                    text: @tr("Spread");
                                                    NumberField { text <=> root.sh-spread; scrub: 0.5; step: 1; minimum: 0; maximum: 100; unit: "%"; label: @tr("Spread"); invalid: root.invalid == "sh-spread"; edited => { root.sheet-changed(); } }
                                                }
                                                Row {
                                                    text: @tr("Size");
                                                    NumberField { text <=> root.sh-size; scrub: 0.5; step: 1; minimum: 0; unit: "px"; label: @tr("Shadow size"); invalid: root.invalid == "sh-size"; edited => { root.sheet-changed(); } }
                                                }
                                                Row {
                                                    text: @tr("Contour");
                                                    Dropdown {
                                                        label: @tr("Contour");
                                                        items: [@tr("Linear"), @tr("Cone"), @tr("Cone – Inverted"), @tr("Gaussian"), @tr("Half Round"), @tr("Ring"), @tr("Ring – Double"), @tr("Rolling Slope – Descending"), @tr("Rounded Steps"), @tr("Sawtooth 1")];
                                                        current: root.sh-contour;
                                                        selected(i) => { root.sh-contour = i; root.sheet-changed(); }
                                                    }
                                                }
                                                Row {
                                                    text: @tr("Anti-aliased");
                                                    VerticalLayout {
                                                        alignment: center;
                                                        Switch { on: root.sh-aa; label: @tr("Anti-aliased"); toggled => { root.sh-aa = !root.sh-aa; root.sheet-changed(); } }
                                                    }
                                                }
                                                Row {
                                                    text: @tr("Noise");
                                                    NumberField { text <=> root.sh-noise; scrub: 0.5; step: 1; minimum: 0; maximum: 100; unit: "%"; label: @tr("Noise"); invalid: root.invalid == "sh-noise"; edited => { root.sheet-changed(); } }
                                                }
                                                Row {
                                                    text: @tr("Text knocks out drop shadow");
                                                    VerticalLayout {
                                                        alignment: center;
                                                        Switch { on: root.sh-knock; label: @tr("Text knocks out drop shadow"); toggled => { root.sh-knock = !root.sh-knock; root.sheet-changed(); } }
                                                    }
                                                }
                                                Para { text: @tr("As in Photoshop’s layer style: the angle is where the light comes from, the shadow falls the other way. With Use global light every text that has it on shares one angle. Spread hardens the edge, Size softens it, the contour shapes how it fades, noise roughens it."); }
                                            }
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    padding-top: 4px;
                                    alignment: start;
                                    CheckButton { text: @tr("Add text"); small: true; clicked => { root.text-add(); } }
                                }
                                    Rectangle { height: 8px; }
                                    Row {
                                        text: @tr("Grid");
                                        VerticalLayout {
                                            alignment: center;
                                            Switch { on: root.head-grid; label: @tr("Grid"); toggled => { root.head-grid = !root.head-grid; } }
                                        }
                                    }
                                    if root.head-grid: Row {
                                        text: @tr("Grid every");
                                        NumberField { text <=> root.head-grid-step; scrub: 0.05; step: 1; minimum: 1; unit: "%"; label: @tr("Grid every"); }
                                    }
                                    if root.head-grid: Para { text: @tr("The grid is only shown in the preview, it is not exported. It covers the page, or the area inside the crop marks; the stronger lines are its middle. The small ticks on the frame of the open text turn green when its middle lies on a grid line."); }
                            }
                        }
                    }
                    ScrollThumb { x: parent.width + 10px; view: side-flick.height; content: tabs.preferred-height; offset: side-flick.content-y; }
                }
                Rectangle { height: 6px; }

                // presets and export stay at the bottom on every tab
                SectionLabel { text: @tr("PRESET"); }
                if root.preset-edit == 0: Row {
                    text: @tr("Preset");
                    PresetMenu {
                        items: root.presets;
                        current: root.preset;
                        title: root.preset >= 0 ? root.presets[root.preset] : root.presets.length > 0 ? @tr("Choose…") : @tr("None yet");
                        chosen(i) => { root.preset-chosen(i); }
                        new => { root.preset-draft = ""; root.preset-status = ""; root.preset-edit = 1; }
                        update => { root.preset-update(); }
                        rename => { root.preset-draft = root.presets[root.preset]; root.preset-status = ""; root.preset-edit = 2; }
                        delete => { root.preset-status = ""; root.preset-edit = 3; }
                    }
                }
                // name a new preset or rename the current one, right in the column
                if root.preset-edit == 1 || root.preset-edit == 2: HorizontalLayout {
                    spacing: 8px;
                    FieldFrame {
                        height: 26px;
                        border-color: name-input.has-focus ? Theme.accent : Theme.line;
                        if root.preset-draft == "": Text {
                            x: 8px;
                            height: parent.height;
                            text: @tr("Name of the preset");
                            font-size: 12px;
                            color: Theme.faint;
                            vertical-alignment: center;
                        }
                        name-input := TextInput {
                            x: 8px;
                            width: parent.width - 16px;
                            height: parent.height;
                            text <=> root.preset-draft;
                            font-size: 12px;
                            color: Theme.text;
                            vertical-alignment: center;
                            single-line: true;
                            accessible-label: @tr("Name of the preset");
                            init => { self.focus(); self.select-all(); }
                            accepted => { root.preset-commit(); }
                            key-pressed(e) => {
                                if e.text == Key.Escape { root.preset-edit = 0; return accept; }
                                reject
                            }
                        }
                    }
                    CheckButton { text: @tr("Cancel"); small: true; clicked => { root.preset-edit = 0; root.preset-status = ""; } }
                    CheckButton { text: @tr("Save"); small: true; primary: true; enabled: root.preset-draft != ""; clicked => { root.preset-commit(); } }
                }
                if root.preset-edit == 3: HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: @tr("Delete “{}”?", root.presets[root.preset]);
                        font-size: 12px;
                        color: Theme.text;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    CheckButton { text: @tr("Cancel"); small: true; clicked => { root.preset-edit = 0; } }
                    CheckButton { text: @tr("Delete"); small: true; primary: true; clicked => { root.preset-delete(); } }
                }
                if root.preset-status != "": Para { text: root.preset-status; color: Theme.muted; }
                SectionLabel { text: @tr("EXPORT"); }
                Row {
                    text: @tr("Format");
                    Dropdown {
                        label: @tr("Format");
                        items: ["PNG", "TIFF", "JPEG", "PDF"];
                        current: root.export-format;
                        selected(i) => { root.export-format = i; }
                    }
                    CheckButton {
                        text: root.exporting ? @tr("Saving…") : @tr("Save…");
                        small: true;
                        primary: root.state == 2;
                        enabled: root.state == 2 && !root.exporting;
                        clicked => { root.export(); }
                    }
                }
                if root.export-status != "": Para { text: root.export-status; color: Theme.muted; }
                if root.can-reveal: HorizontalLayout {
                    alignment: start;
                    CheckButton { text: @tr("Show in Finder"); small: true; clicked => { root.reveal(); } }
                }
            }
        }

        // preview: the page on the desk, as large as fits
        desk := Rectangle {
            background: Theme.desk;
            clip: true;
            property <length> room-w: self.width - 64px;
            property <length> room-h: self.height - 64px;
            property <bool> wide: self.room-w / self.room-h > root.page-aspect;
            // page size when it fits
            property <length> fit-w: desk.wide ? desk.room-h * root.page-aspect : desk.room-w;
            property <length> fit-h: desk.wide ? desk.room-h : desk.room-w / root.page-aspect;
            property <float> start-zoom: 1;
            property <length> start-x;
            property <length> start-y;
            // the page may move until 40 px of it are left in view; when it fits it stays centred
            function clamp-pan() {
                root.pan-x = clamp(root.pan-x, -max(0px, (desk.fit-w * root.zoom - desk.width) / 2 + 40px), max(0px, (desk.fit-w * root.zoom - desk.width) / 2 + 40px));
                root.pan-y = clamp(root.pan-y, -max(0px, (desk.fit-h * root.zoom - desk.height) / 2 + 40px), max(0px, (desk.fit-h * root.zoom - desk.height) / 2 + 40px));
                if root.zoom <= 1 { root.pan-x = 0; root.pan-y = 0; }
            }
            // new zoom, the point (px, py) of the desk stays where it is
            function zoom-to(z: float, px: length, py: length) {
                let nz = clamp(z, 0.25, 8); // 25–800 %
                let dx = px - desk.width / 2;
                let dy = py - desk.height / 2;
                root.pan-x = dx - (dx - root.pan-x) * nz / root.zoom;
                root.pan-y = dy - (dy - root.pan-y) * nz / root.zoom;
                root.zoom = nz;
                desk.clamp-pan();
                root.zoom-changed(nz);
            }
            changed width => { desk.clamp-pan(); }
            changed height => { desk.clamp-pan(); }

            page := Rectangle {
                width: desk.fit-w * root.zoom;
                height: desk.fit-h * root.zoom;
                x: (desk.width - self.width) / 2 + root.pan-x;
                y: (desk.height - self.height) / 2 + root.pan-y;
                background: root.bg-swatch;
                drop-shadow-blur: 18px;
                drop-shadow-color: #00000059;
                drop-shadow-offset-y: 4px;
                Image {
                    width: parent.width;
                    height: parent.height;
                    source: root.preview;
                    image-fit: fill;
                    accessible-role: image;
                    accessible-label: @tr("Preview of the sheet");
                }
            }
            // grid in percent of the trim area (the page without crop marks), where the headline hangs (Headline
            // tab); the 50 % lines stronger; each line centred on its place, like the ticks of the headline frame
            if root.side-tab == 3 && root.head-grid: Rectangle {
                x: page.x + page.width * root.trim-x;
                y: page.y + page.height * root.trim-y;
                width: page.width * root.trim-w;
                height: page.height * root.trim-h;
                for i in Math.ceil(100 / root.grid-step) - 1: Rectangle {
                    x: parent.width * (i + 1) * root.grid-step / 100 - 0.5px;
                    width: 1px;
                    height: parent.height;
                    background: Theme.accent.with-alpha((i + 1) * root.grid-step == 50 ? 0.6 : 0.25);
                }
                for i in Math.ceil(100 / root.grid-step) - 1: Rectangle {
                    y: parent.height * (i + 1) * root.grid-step / 100 - 0.5px;
                    height: 1px;
                    width: parent.width;
                    background: Theme.accent.with-alpha((i + 1) * root.grid-step == 50 ? 0.6 : 0.25);
                }
            }
            // pinch on the trackpad
            ScaleRotateGestureHandler {
                started => { desk.start-zoom = root.zoom; }
                updated => { desk.zoom-to(desk.start-zoom * self.scale, self.center.x, self.center.y); }
                // drag to move, scroll to move, ⌘ + scroll to zoom, double-click: fit / 200 %
                drag := TouchArea {
                    mouse-cursor: root.zoom > 1 ? (self.pressed ? MouseCursor.grabbing : MouseCursor.grab) : MouseCursor.default;
                    pointer-event(e) => {
                        if e.kind == PointerEventKind.down {
                            desk.start-x = root.pan-x;
                            desk.start-y = root.pan-y;
                        }
                    }
                    moved => {
                        if self.pressed && root.zoom > 1 {
                            root.pan-x = desk.start-x + self.mouse-x - self.pressed-x;
                            root.pan-y = desk.start-y + self.mouse-y - self.pressed-y;
                            desk.clamp-pan();
                        }
                    }
                    double-clicked => {
                        if Math.abs(root.zoom - 1) > 0.01 { desk.zoom-to(1, self.mouse-x, self.mouse-y); } else { desk.zoom-to(2, self.mouse-x, self.mouse-y); }
                    }
                    // Sheet tab, photomosaic: a click (not a drag) on a still makes it the main picture
                    clicked => {
                        if root.side-tab == 1 && root.mosaic-on && Math.abs(self.mouse-x - self.pressed-x) < 3px && Math.abs(self.mouse-y - self.pressed-y) < 3px {
                            root.page-clicked((self.mouse-x - page.x) / page.width, (self.mouse-y - page.y) / page.height);
                        }
                    }
                    scroll-event(e) => {
                        if e.modifiers.control {
                            desk.zoom-to(root.zoom * Math.pow(1.0025, -e.delta-y / 1px), self.mouse-x, self.mouse-y);
                        } else if root.zoom > 1 {
                            root.pan-x += e.delta-x;
                            root.pan-y += e.delta-y;
                            desk.clamp-pan();
                        } else {
                            return reject;
                        }
                        accept
                    }
                }
            }
            // above the pan / zoom area, so it gets the mouse first (below it, a drag only reached the pan area).
            // On the Headline tab the headline can be dragged: the frame and its ticks go where X and Y put the text
            // (the preview follows from Rust a moment later); the area that takes the mouse stays put while dragging,
            // so the way of the mouse is measured from a fixed place. With the grid on, the middle snaps to a grid
            // line it comes within 6 screen pixels of, so it can lie exactly on it.
            // the other texts: a faint frame, a click opens that text (then it can be dragged)
            if root.side-tab == 3: Rectangle {
                width: desk.width;
                height: desk.height;
                for b[bi] in root.text-boxes: Rectangle {
                    visible: bi != root.text-open && b.w > 0;
                    x: page.x + page.width * b.x - 4px;
                    y: page.y + page.height * b.y - 4px;
                    width: page.width * b.w + 8px;
                    height: page.height * b.h + 8px;
                    border-width: 1px;
                    border-radius: 3px;
                    border-color: other.has-hover ? Theme.accent.with-alpha(0.7) : Theme.accent.with-alpha(0.2);
                    other := TouchArea { mouse-cursor: pointer; clicked => { root.text-open-at(bi); } }
                }
            }
            if root.side-tab == 3 && root.headline != "" && root.head-bw > 0: Rectangle {
                width: desk.width;
                height: desk.height;
                property <float> bx0;
                property <float> by0;
                property <float> dx0;
                property <float> dy0;
                property <float> page-h-px: root.page-px / root.page-aspect;
                property <float> dx: root.head-dx.is-float() ? root.head-dx.to-float() : 0;
                property <float> dy: root.head-dy.is-float() ? root.head-dy.to-float() : 0;
                frame := Rectangle {
                    x: page.x + page.width * (hd.pressed ? parent.bx0 + (parent.dx - parent.dx0) / root.page-px : root.head-bx) - 4px;
                    y: page.y + page.height * (hd.pressed ? parent.by0 + (parent.dy - parent.dy0) / parent.page-h-px : root.head-by) - 4px;
                    width: page.width * root.head-bw + 8px;
                    height: page.height * root.head-bh + 8px;
                    border-width: 1px;
                    border-radius: 3px;
                    border-color: hd.has-hover || hd.pressed ? Theme.accent : Theme.accent.with-alpha(0.35);
                    // ticks (1 px like the grid lines) across the frame at the middle of each side: where the centre of the text is; green when
                    // the middle lies on a grid line (top / bottom ticks: a vertical line, left / right: a horizontal one)
                    Rectangle { x: parent.width / 2 - 0.5px; y: -7px; width: 1px; height: 14px; background: root.on-grid-x ? Theme.online : Theme.accent; }
                    Rectangle { x: parent.width / 2 - 0.5px; y: parent.height - 7px; width: 1px; height: 14px; background: root.on-grid-x ? Theme.online : Theme.accent; }
                    Rectangle { x: -7px; y: parent.height / 2 - 0.5px; width: 14px; height: 1px; background: root.on-grid-y ? Theme.online : Theme.accent; }
                    Rectangle { x: parent.width - 7px; y: parent.height / 2 - 0.5px; width: 14px; height: 1px; background: root.on-grid-y ? Theme.online : Theme.accent; }
                }
                hd := TouchArea {
                    x: page.x + page.width * (self.pressed ? parent.bx0 : root.head-bx) - 4px;
                    y: page.y + page.height * (self.pressed ? parent.by0 : root.head-by) - 4px;
                    width: frame.width;
                    height: frame.height;
                    mouse-cursor: move;
                    pointer-event(e) => {
                        if e.kind == PointerEventKind.down {
                            parent.bx0 = root.head-bx;
                            parent.by0 = root.head-by;
                            parent.dx0 = parent.dx;
                            parent.dy0 = parent.dy;
                        }
                    }
                    moved => {
                        if self.pressed {
                            let per = root.page-px / (page.width / 1px);
                            let ddx = (self.mouse-x - self.pressed-x) / 1px * per;
                            let ddy = (self.mouse-y - self.pressed-y) / 1px * per;
                            // the middle as a fraction of the page, and the nearest grid line
                            let cx = parent.bx0 + root.head-bw / 2 + ddx / root.page-px;
                            let cy = parent.by0 + root.head-bh / 2 + ddy / parent.page-h-px;
                            let kx = Math.round((cx - root.trim-x) / root.trim-w * 100 / root.grid-step) * root.grid-step;
                            let ky = Math.round((cy - root.trim-y) / root.trim-h * 100 / root.grid-step) * root.grid-step;
                            let lx = root.trim-x + root.trim-w * kx / 100;
                            let ly = root.trim-y + root.trim-h * ky / 100;
                            let snap-x = root.head-grid && kx > 0 && kx < 100 && Math.abs(lx - cx) * page.width < 6px;
                            let snap-y = root.head-grid && ky > 0 && ky < 100 && Math.abs(ly - cy) * page.height < 6px;
                            root.head-dx = Math.round(parent.dx0 + ddx + (snap-x ? (lx - cx) * root.page-px : 0));
                            root.head-dy = Math.round(parent.dy0 + ddy + (snap-y ? (ly - cy) * parent.page-h-px : 0));
                            root.sheet-changed();
                        }
                    }
                }
            }
            // zoom controls, bottom right
            Rectangle {
                x: desk.width - self.width - 16px;
                y: desk.height - self.height - 16px;
                width: zoom-row.preferred-width;
                height: 30px;
                border-radius: 8px;
                background: Theme.background.with-alpha(0.92);
                border-width: 1px;
                border-color: Theme.line;
                zoom-row := HorizontalLayout {
                    padding: 2px;
                    padding-left: 4px;
                    padding-right: 4px;
                    spacing: 2px;
                    ZoomButton { text: "−"; label: @tr("Zoom out"); enabled: root.zoom > 0.26; clicked => { desk.zoom-to(root.zoom / 1.5, desk.width / 2, desk.height / 2); } }
                    Text {
                        text: Math.round(root.zoom * 100) + " %";
                        min-width: 52px;
                        font-size: 11px;
                        color: Theme.muted;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    ZoomButton { text: "+"; label: @tr("Zoom in"); enabled: root.zoom < 8; clicked => { desk.zoom-to(root.zoom * 1.5, desk.width / 2, desk.height / 2); } }
                    ZoomButton { text: @tr("Fit"); label: @tr("Fit the whole sheet"); enabled: Math.abs(root.zoom - 1) > 0.01; clicked => { desk.zoom-to(1, desk.width / 2, desk.height / 2); } }
                }
            }
            // stills still to grab: a small, quiet card at the top centre of the preview (user 2026-11-23)
            if (root.state == 2 && root.missing > 0) || (root.state == 0 && root.can-grab): Rectangle {
                x: (desk.width - self.width) / 2;
                y: 14px;
                width: pill.preferred-width;
                height: 32px;
                border-radius: 10px;
                background: Theme.background.with-alpha(0.94);
                border-width: 1px;
                border-color: Theme.line;
                drop-shadow-blur: 10px;
                drop-shadow-offset-y: 2px;
                drop-shadow-color: #00000030;
                pill := HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 4px;
                    spacing: 10px;
                    Text {
                        text: root.state == 2 ? @tr("{} stills still to grab", root.missing) : @tr("Stills not grabbed yet");
                        font-size: 11px;
                        color: Theme.muted;
                        vertical-alignment: center;
                    }
                    VerticalLayout {
                        alignment: center;
                        CheckButton { small: true; text: @tr("Grab"); primary: true; enabled: root.can-grab; clicked => { root.grab(); } }
                    }
                }
            }
            if root.state == 0 && root.source-info == "": Text {
                text: root.mode == 0 ? @tr("Choose a master file and its cut list – or drag them here.") : @tr("Choose a bin with your sequence.");
                font-size: 13px;
                color: #60666c;
                x: page.x + (page.width - self.width) / 2;
                y: page.y + (page.height - self.height) / 2;
            }
        }
    }
    if Shared.update-version != "": UpdateCard {
        x: (root.width - self.width) / 2;
        y: root.height - self.height - 18px;
    }
    // files dragged over the window: one big landing area with a file icon in the middle, as in other Mac apps
    if root.drop-hover: Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: Theme.background.with-alpha(0.88);
        Rectangle {
            x: 14px;
            y: 14px;
            width: parent.width - 28px;
            height: parent.height - 28px;
            border-radius: 14px;
            border-width: 2px;
            border-color: root.state == 1 ? Theme.line : Theme.accent;
            background: root.state == 1 ? transparent : Theme.accent.with-alpha(0.06);
        }
        VerticalLayout {
            alignment: center;
            spacing: 14px;
            HorizontalLayout {
                alignment: center;
                // a sheet of paper with a folded corner
                Path {
                    width: 56px;
                    height: 70px;
                    viewbox-width: 56;
                    viewbox-height: 70;
                    commands: "M 4 2 L 38 2 L 54 18 L 54 68 L 4 68 Z M 38 2 L 38 18 L 54 18";
                    stroke: root.state == 1 ? Theme.disabled : Theme.accent;
                    stroke-width: 2.5px;
                    fill: Theme.background;
                }
            }
            Text {
                text: root.state == 1 ? @tr("Please wait until CineMosaic is done") : @tr("Drop master files and cut lists");
                font-size: 17px;
                font-weight: 600;
                color: Theme.text;
                horizontal-alignment: center;
            }
            Text {
                text: root.state == 1 ? "" : @tr("Videos become master files; EDL, XML, FCPXML and AAF become cut lists.");
                font-size: 12px;
                color: Theme.muted;
                horizontal-alignment: center;
            }
        }
    }
}
