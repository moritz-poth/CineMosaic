// CineMosaic window. Look and parts from MediaFiles Check (Theme, CheckButton, Dropdown, Switch). Texts in English in @tr().
import { Palette, Spinner, Slider } from "std-widgets.slint";
import "fonts/JetBrainsMono-Regular.ttf";
import "fonts/JetBrainsMono-Medium.ttf";
import "fonts/JetBrainsMono-SemiBold.ttf";
import "fonts/JetBrainsMono-Bold.ttf";

export struct MenuChoice {
    title: string,
    checked: bool,
}

export struct HelpBlock {
    heading: string,
    body: styled-text,
    // screenshot (2x pixels), shown at half its pixel size, never wider than the text
    picture: image,
}

export struct TestRow {
    title: string,
    detail: string,
    status: int,
}

export struct VolumeRow {
    name: string,
    on: bool,
}

export global Metrics {
    out property <length> side-width: 380px;
    // wrapped texts need a fixed width: the side column minus its padding
    out property <length> text-width: 380px - 2 * 28px;
    // manual window
    out property <length> padding: 32px;
    out property <length> spacing: 24px;
}

export global Theme {
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    out property <color> background: dark ? #1f2225 : #f5f5f3;
    out property <color> text: dark ? #eceded : #17191b;
    out property <color> muted: dark ? #a9adb1 : #3f444a;
    out property <color> faint: dark ? #858b91 : #60666c;
    out property <color> line: dark ? #3a3f44 : #c4c8cc;
    out property <color> disabled: dark ? #6a7076 : #70767c;
    out property <color> primary: dark ? #e6e7e8 : #2e3236;
    out property <color> on-primary: dark ? #1f2225 : #f5f5f3;
    out property <color> error: dark ? #f85149 : #c62828;
    out property <color> accent: dark ? #0a84ff : #007aff;
    out property <color> online: dark ? #3fb950 : #1a7f37;
    out property <color> partial: dark ? #f0883e : #b4530f;
    out property <color> sidebar: dark ? #232629 : #ececea;
    // the preview's desk behind the white page
    out property <color> desk: dark ? #16181a : #dcdcd9;
}

component Headline inherits VerticalLayout {
    padding-bottom: 6px;
    Text {
        text: "CINEMOSAIC";
        font-family: "Helvetica Neue";
        font-size: 31px;
        font-weight: 300;
        letter-spacing: 2.5px;
        color: Theme.text;
    }
}

component SectionLabel inherits Text {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1px;
    color: Theme.muted;
}

component Para inherits Text {
    width: Metrics.text-width;
    wrap: word-wrap;
    font-size: 11px;
    color: Theme.faint;
}

component CheckButton {
    in property <string> text;
    in property <bool> primary;
    in property <bool> enabled: true;
    in property <bool> small;
    callback clicked;
    min-width: label.preferred-width + (root.small ? 24px : 28px);
    preferred-width: self.min-width;
    height: root.small ? 26px : 32px;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    Rectangle {
        border-radius: 6px;
        border-width: 1px;
        border-color: root.primary && root.enabled ? Theme.primary : Theme.line;
        background: !root.enabled ? transparent
            : root.primary ? (touch.pressed ? Theme.primary.darker(0.15) : Theme.primary)
            : touch.pressed ? Theme.text.with-alpha(0.12) : touch.has-hover ? Theme.text.with-alpha(0.06) : transparent;
    }
    label := Text {
        text: root.text;
        font-size: root.small ? 12px : 13px;
        font-weight: root.small ? (root.primary ? 700 : 600) : root.primary ? 600 : 400;
        color: !root.enabled ? Theme.disabled : root.primary ? Theme.on-primary : Theme.text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

// Mountpoint switch: capsule 34 × 20, knob right = on
component Switch inherits Rectangle {
    in property <bool> on;
    in property <string> label;
    callback toggled;
    width: 34px;
    height: 20px;
    border-radius: 10px;
    background: root.on ? Theme.primary : Theme.line;
    accessible-role: switch;
    accessible-label: root.label;
    accessible-checked: root.on;
    accessible-action-default => { root.toggled(); }
    Rectangle {
        x: root.on ? parent.width - self.width - 2px : 2px;
        y: 2px;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: root.on ? Theme.on-primary : (Theme.dark ? Theme.muted : Theme.background);
        animate x { duration: 150ms; easing: ease-out; }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }
}

// Mountpoint dropdown: Ferry-style button with value and chevron, the native menu below it, current entry disabled
component Dropdown {
    in property <[string]> items;
    in property <int> current;
    in property <string> label;
    callback selected(int);
    height: 26px;
    min-width: row.preferred-width;
    max-width: row.preferred-width;
    horizontal-stretch: 0;
    accessible-role: combobox;
    accessible-label: root.label;
    accessible-value: root.items[root.current];
    accessible-action-default => { menu.show({ x: 0, y: root.height + 4px }); }
    Rectangle {
        border-radius: 6px;
        border-width: 1px;
        border-color: Theme.line;
        background: touch.pressed ? Theme.text.with-alpha(0.12) : touch.has-hover ? Theme.text.with-alpha(0.06) : transparent;
    }
    row := HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 6px;
        Text {
            text: root.items[root.current];
            font-size: 12px;
            vertical-alignment: center;
            color: Theme.text;
        }
        VerticalLayout {
            alignment: center;
            Path {
                width: 8px;
                height: 5px;
                commands: "M 0 0 L 4 4 L 8 0";
                stroke: Theme.text;
                stroke-width: 1.5px;
            }
        }
    }
    menu := ContextMenuArea {
        Menu {
            for item[i] in root.items: MenuItem {
                title: item;
                enabled: i != root.current;
                activated => { root.selected(i); }
            }
        }
        touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { menu.show({ x: 0, y: root.height + 4px }); }
        }
    }
}

// Number with its unit; frame like Mountpoint's text fields, red when Rust could not read it
component NumberField inherits Rectangle {
    in-out property <string> text;
    in property <string> unit;
    in property <string> label;
    in property <bool> invalid;
    callback edited();
    width: 96px;
    height: 26px;
    border-radius: 6px;
    border-width: 1px;
    border-color: root.invalid ? Theme.error : input.has-focus ? Theme.accent : Theme.line;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 4px;
        input := TextInput {
            text <=> root.text;
            font-size: 12px;
            color: Theme.text;
            vertical-alignment: center;
            horizontal-alignment: right;
            single-line: true;
            accessible-label: root.label;
            edited => { root.edited(); }
        }
        Text {
            text: root.unit;
            font-size: 12px;
            color: Theme.faint;
            vertical-alignment: center;
            horizontal-stretch: 0;
        }
    }
}

// Short text left, control right
component Row inherits HorizontalLayout {
    in property <string> text;
    spacing: 10px;
    height: 30px;
    Text {
        text: root.text;
        font-size: 12px;
        horizontal-stretch: 1;
        vertical-alignment: center;
        color: Theme.text;
    }
    @children
}

component ProgressBar inherits Rectangle {
    in property <float> value;
    height: 6px;
    border-radius: 3px;
    background: Theme.line;
    Rectangle {
        x: 0;
        width: parent.width * clamp(root.value, 0, 1);
        border-radius: 3px;
        background: Theme.primary;
    }
}

export global Shared {
    // Größe des Fensters hat sich geändert (jedes Fenster hat sein eigenes Shared)
    callback resized();
    in property <[MenuChoice]> languages;
    in property <[string]> language-names;
    in property <int> language-index;
    in property <[bool]> appearance;
    in property <bool> dark: true;
    in property <bool> betas;
    callback select-language(int);
    callback select-dark(bool);
    callback select-betas(bool);
    callback show-help();
    callback show-about();
    callback show-settings();
    callback show-log();
    // Updates (src/update.rs): laufende Version, neuere Version ("" = keine), Zustand 0 nichts, 1 prüft, 2 aktuell,
    // 3 installiert, 4 Fehler; Fehlerart 0 Prüfen, 1 Laden, 2 beschädigt, 3 Ersetzen, 4 Neustart
    in property <string> version;
    in property <string> update-version;
    in property <int> update-state;
    in property <int> update-error;
    in property <string> update-details;
    callback check-update();
    callback install-update();
    callback show-release();
    // Rust: Update-Zustand hat sich geändert, alle Fenster neu setzen
    callback refresh-update();
}


// Zustand der Updates als Text (Einstellungen und Banner)
component UpdateStatus inherits Text {
    width: Metrics.text-width;
    wrap: word-wrap;
    font-size: 12px;
    visible: self.text != "";
    height: self.visible ? self.preferred-height : 0;
    color: Shared.update-state == 4 ? Theme.error : Theme.muted;
    text: Shared.update-state == 1 ? @tr("Checking for updates…")
        : Shared.update-state == 2 ? @tr("CineMosaic is up to date.")
        : Shared.update-state == 3 ? @tr("Installing the update – CineMosaic restarts by itself.")
        : Shared.update-state != 4 ? ""
        : Shared.update-error == 0 ? @tr("Could not check for updates. Check the internet connection and try again.")
        : Shared.update-error == 1 ? @tr("The update could not be downloaded. Check the internet connection and try again.")
        : Shared.update-error == 2 ? @tr("The downloaded update is damaged. Please try again later or download it from GitHub.")
        : Shared.update-error == 3 ? @tr("CineMosaic could not replace itself. Move it to the Applications folder, or download the update from GitHub. Details: {}", Shared.update-details)
        : @tr("The update is installed. Quit CineMosaic and open it again to finish.");
}

// Neue Version: Hinweis mit "Neuigkeiten" und "Update installieren" (oben im Hauptfenster und in den Einstellungen)
component UpdateOffer inherits VerticalLayout {
    in property <length> text-width: Metrics.text-width;
    spacing: 10px;
    Text {
        width: root.text-width;
        wrap: word-wrap;
        text: @tr("Version {} is available.", Shared.update-version);
        font-weight: 600;
        color: Theme.text;
    }
    HorizontalLayout {
        spacing: 10px;
        alignment: start;
        CheckButton {
            text: @tr("What's new");
            clicked => { Shared.show-release(); }
        }
        CheckButton {
            text: @tr("Install update");
            primary: true;
            enabled: Shared.update-state != 3;
            clicked => { Shared.install-update(); }
        }
    }
}

// Base of every window: app font, colours from Shared.dark, Help menu (on the Mac the menu belongs to the active window)
component SheetWindow inherits Window {
    default-font-family: "JetBrains Mono";
    default-font-size: 13px;
    background: Theme.background;
    property <bool> dark: Shared.dark;
    init => {
        Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light;
    }
    changed dark => {
        Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light;
    }
    changed height => { Shared.resized(); }
    MenuBar {
        Menu {
            title: @tr("Help");
            MenuItem {
                title: @tr("CineMosaic Manual");
                activated => { Shared.show-help(); }
            }
            MenuItem {
                title: @tr("Show Log File");
                activated => { Shared.show-log(); }
            }
        }
    }
}

component SettingsTab {
    in property <image> icon;
    in property <string> text;
    in property <bool> selected;
    // kleiner oranger Punkt: dort wartet etwas (Hauptfenster)
    in property <bool> attention;
    callback clicked;
    min-width: max(label.preferred-width + 14px, 44px);
    height: 45px;
    accessible-role: tab;
    accessible-label: root.text;
    accessible-checked: root.selected;
    accessible-description: root.attention ? @tr("needs attention") : "";
    accessible-action-default => { root.clicked(); }
    Rectangle {
        border-radius: 6px;
        background: root.selected ? (Theme.dark ? #ffffff14 : #00000012) : transparent;
    }
    VerticalLayout {
        padding-top: 2px;
        padding-bottom: 2px;
        spacing: 0px;
        alignment: center;
        HorizontalLayout {
            alignment: center;
            Image {
                source: root.icon;
                width: 23px;
                height: 23px;
                colorize: root.selected ? Theme.accent : label.color;
                if root.attention: Rectangle {
                    x: parent.width - 3px;
                    y: -1px;
                    width: 7px;
                    height: 7px;
                    border-radius: 3.5px;
                    background: Theme.partial;
                }
            }
        }
        label := Text {
            text: root.text;
            // Systemschrift-Alias verlor in Slint Umlaute („Über“ → „Uber“); Helvetica Neue gibt es auf jedem Mac
            font-family: "Helvetica Neue";
            font-size: 12px;
            horizontal-alignment: center;
            // dunkel 55 % Weiß (4.8:1), hell 65 % Schwarz (5.9:1 auf #f0f0f0; 50 % wären nur 3.9:1)
            color: root.selected ? Theme.accent : Theme.dark ? #ffffff8c : #000000a6;
        }
    }
    TouchArea {
        clicked => { root.clicked(); }
    }
}

component Section inherits VerticalLayout {
    in property <string> title;
    spacing: 10px;
    Text {
        text: root.title;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 1px;
        color: Theme.muted;
    }
    @children
}

component Divider inherits Rectangle {
    height: 1px;
    background: Theme.line;
}


component ScrollThumb inherits Rectangle {
    in property <length> view;
    in property <length> content;
    in property <length> offset;
    // height the thumb runs along (a card with padding: the whole card, not only its scrolling part)
    in property <length> track: root.view;
    visible: root.content > root.view;
    width: 6px;
    height: max(24px, (root.track - 4px) * root.view / max(root.content, 1px));
    y: 2px + (root.content > root.view ? -root.offset / (root.content - root.view) * (root.track - 4px - self.height) : 0px);
    border-radius: 3px;
    background: Theme.dark ? #ffffff59 : #00000059;
}


export component HelpWindow inherits SheetWindow {
    title: @tr("CineMosaic Manual");
    width: 720px;
    height: 860px;

    in property <string> subtitle;
    in property <[HelpBlock]> blocks;

    VerticalLayout {
        padding: Metrics.padding;
        spacing: Metrics.spacing;

        Headline { }
        Section {
            title: root.subtitle;
        }
        Divider { }
        // eigene Scrollfläche: die Standard-ScrollView rückt den Inhalt ein
        Rectangle {
            vertical-stretch: 1;
            flick := Flickable {
                content-height: content.preferred-height;
                content := VerticalLayout {
                    x: 0;
                    width: flick.width - 16px;
                    spacing: 12px;
                    padding-bottom: 16px;
                    for b in root.blocks: VerticalLayout {
                        padding-top: b.heading != "" ? 16px : 0;
                        if b.heading != "": Text {
                            text: b.heading;
                            font-size: 15px;
                            font-weight: 600;
                            wrap: word-wrap;
                            color: Theme.text;
                        }
                        // feste Breite: sonst misst Slint den Absatz ungebrochen und die Scrollhöhe ist zu klein
                        // framed: the screenshots are dark and would blend into the page
                        if b.picture.width > 0: Rectangle {
                            width: min(content.width, b.picture.width * 0.5px + 2px);
                            height: (self.width - 2px) * b.picture.height / b.picture.width + 2px;
                            border-width: 1px;
                            border-color: Theme.line;
                            border-radius: 6px;
                            clip: true;
                            Image {
                                x: 1px;
                                y: 1px;
                                width: parent.width - 2px;
                                height: parent.height - 2px;
                                source: b.picture;
                            }
                        }
                        if b.heading == "" && b.picture.width == 0: StyledText {
                            width: content.width;
                            text: b.body;
                            default-color: Theme.text;
                            link-color: Theme.text;
                        }
                    }
                }
            }
            if flick.content-height > flick.height: Rectangle {
                x: parent.width - self.width;
                width: 4px;
                height: max(24px, flick.height * flick.height / flick.content-height);
                y: -flick.content-y / (flick.content-height - flick.height) * (flick.height - self.height);
                border-radius: 2px;
                background: Theme.line;
            }
        }
    }
}

// Zeile wie in Mountpoint: kurzer Text links, Bedienelement rechtsbündig
component SettingRow inherits HorizontalLayout {
    in property <string> text;
    spacing: 10px;
    Text {
        text: root.text;
        // Mountpoints Regular wirkt mit CoreText (dunkel, kleine Größen) fast halbfett; Slint zeichnet dünner
        font-weight: 600;
        horizontal-stretch: 1;
        vertical-alignment: center;
        wrap: word-wrap;
        color: Theme.text;
    }
    @children
}

// Erklärung unter einer Zeile (Mountpoint: hint, 11 pt, blass, höchstens 390 breit)
component Hint inherits Text {
    width: 390px;
    wrap: word-wrap;
    font-size: 11px;
    color: Theme.faint;
}

// Rollbalken wie macOS' Overlay-Scroller in Mountpoints ScrollView: 6 px, abgerundet, 2 px vom Rand

// Rahmen wie Mountpoints Eingabefelder: 1 px Linie, Ecken 6, keine eigene Fläche
component FieldFrame inherits Rectangle {
    border-radius: 6px;
    border-width: 1px;
    border-color: Theme.line;
    clip: true;
}

// Einstellungen wie in Mountpoint (seit 1.0.0 beta 7): eigenes Fenster 800 × 450 (16:9, nie größer), Inhalt bis unter die
// durchsichtige Titelleiste (Rust: mac_window::unify_titlebar), Reiterleiste in der Farbe der Titelleiste – heller,
// solange das Fenster aktiv ist (active, von Rust gesetzt) –, Titel = Reiter, Spalte von 560 px mittig.
// Kein Reiter wächst oder scrollt – nur die Selbsttest-Liste und das Beschreibungsfeld scrollen in sich.
export component SettingsWindow inherits SheetWindow {
    // gleiche Wirkung wie Mountpoints Regular mit CoreText (gemessen: Slint-Text sonst rund 20 % heller)
    default-font-weight: 500;
    title: root.tab == 0 ? @tr("General") : root.tab == 1 ? @tr("Updates") : root.tab == 2 ? @tr("Support") : @tr("About");
    width: 800px;
    height: 450px;

    // Reiter: 0 Allgemein, 1 Updates, 2 Support, 3 Über; last-tab = zuletzt gewählter außer „Über“ (für „Einstellungen…“,
    // in settings.txt gesichert)
    in-out property <int> tab;
    in-out property <int> last-tab;
    callback tab-chosen(int);
    changed tab => {
        if root.tab != 3 && root.tab != root.last-tab {
            root.last-tab = root.tab;
            root.tab-chosen(root.tab);
        }
    }
    in property <bool> active: true;
    in property <string> version;
    callback open-source();
    callback open-license();
    // Support (wie Mountpoint): 0 Übersicht, 1 Selbsttest, 2 Problem melden
    in-out property <int> page;
    // Selbsttest: 0 bereit, 1 läuft, 2 fertig
    in property <int> test-phase;
    in property <[TestRow]> test-rows;
    in property <string> test-current;
    in property <string> test-summary;
    in property <bool> test-failed;
    in property <string> test-note;
    in property <bool> sending;
    in-out property <string> report-text;
    in-out property <string> report-contact;
    in-out property <bool> report-attach: true;
    // kurze Meldung nach dem Senden wie Mountpoints Toast (Rust blendet sie nach 3 s, Fehler 8 s, aus)
    in property <string> toast-text;
    in property <bool> toast-ok;
    in property <bool> toast-visible;
    callback start-selftest();
    callback send-selftest();
    callback save-selftest();
    callback send-problem();
    callback open-coffee();
    callback back();

    property <length> column: 560px;

    VerticalLayout {
        // Titelleiste (28) + Reiter (52), gemessen an Mountpoint
        Rectangle {
            height: 80px;
            background: Theme.dark ? (root.active ? #383838 : #292929) : (root.active ? #f0f0f0 : #e7e7e7);
            HorizontalLayout {
                alignment: center;
                padding-top: 28px;
                padding-bottom: 7px;
                SettingsTab {
                    icon: @image-url("../assets/tabs/general.png");
                    text: @tr("General");
                    selected: root.tab == 0;
                    clicked => { root.tab = 0; }
                }
                SettingsTab {
                    icon: @image-url("../assets/tabs/updates.png");
                    text: @tr("Updates");
                    selected: root.tab == 1;
                    clicked => { root.tab = 1; }
                }
                SettingsTab {
                    icon: @image-url("../assets/tabs/support.png");
                    text: @tr("Support");
                    selected: root.tab == 2;
                    clicked => { root.tab = 2; }
                }
                SettingsTab {
                    icon: @image-url("../assets/tabs/about.png");
                    text: @tr("About");
                    selected: root.tab == 3;
                    clicked => { root.tab = 3; }
                }
            }
        }
        // Trennlinie unter der Werkzeugleiste wie bei macOS (ein Bildpunkt)
        Rectangle {
            height: 0.5px;
            background: Theme.dark ? #000000 : #c6c6c6;
        }
        HorizontalLayout {
            alignment: center;
            // Allgemein ist der Maßstab (wie Mountpoint): seine erste Zeile hat einen Schalter (20 hoch). Reiter, die mit
            // einem Knopf (26 hoch) beginnen, rücken 3 px höher, damit der erste Text überall auf derselben Höhe steht.
            padding-top: root.tab == 2 && root.page != 0 ? 16px : root.tab == 1 || root.tab == 2 ? 21px : 24px;
            padding-bottom: 16px;

            if root.tab == 0: VerticalLayout {
                width: root.column;
                alignment: start;
                spacing: 14px;
                SettingRow {
                    text: @tr("Light/Dark");
                    VerticalLayout {
                        alignment: center;
                        Switch {
                            on: Shared.dark;
                            label: @tr("Light/Dark");
                            toggled => { Shared.select-dark(!Shared.dark); }
                        }
                    }
                }
                Hint { text: @tr("Switches all windows of CineMosaic between a light and a dark look."); }
                SettingRow {
                    text: @tr("Language");
                    VerticalLayout {
                        alignment: center;
                        Dropdown {
                            items: Shared.language-names;
                            current: Shared.language-index;
                            selected(i) => { Shared.select-language(i); }
                        }
                    }
                }
            }

            if root.tab == 1: VerticalLayout {
                width: root.column;
                alignment: start;
                spacing: 14px;
                SettingRow {
                    text: @tr("Version {}", Shared.version);
                    if Shared.update-state == 1: VerticalLayout {
                        alignment: center;
                        Spinner { indeterminate: true; width: 16px; height: 16px; }
                    }
                    CheckButton {
                        small: true;
                        text: @tr("Check for updates");
                        enabled: Shared.update-state != 1 && Shared.update-state != 3;
                        clicked => { Shared.check-update(); }
                    }
                }
                if Shared.update-version != "": UpdateOffer { text-width: root.column; }
                if Shared.update-state != 0: UpdateStatus {
                    width: root.column;
                    font-size: 11px;
                    color: Shared.update-state == 4 ? Theme.partial : Theme.faint;
                }
                Hint { text: @tr("CineMosaic checks GitHub for new versions on its own and shows a notice."); }
                SettingRow {
                    text: @tr("Get test versions");
                    VerticalLayout {
                        alignment: center;
                        Switch {
                            on: Shared.betas;
                            label: @tr("Get test versions");
                            toggled => { Shared.select-betas(!Shared.betas); }
                        }
                    }
                }
                Hint { text: @tr("Also offers versions that are still being tested. For testers only – they can contain errors."); }
            }

            if root.tab == 2 && root.page == 0: VerticalLayout {
                width: root.column;
                alignment: start;
                spacing: 14px;
                SettingRow {
                    text: root.test-phase == 1 ? @tr("Self-test running…") : @tr("Test this Mac");
                    CheckButton {
                        small: true;
                        text: @tr("Run self-test…");
                        clicked => { root.page = 1; }
                    }
                }
                Hint { text: @tr("Tests ffmpeg, grabbing frames, reading cut lists, saving sheets and updates on test data of its own and sends us an anonymous report."); }
                SettingRow {
                    text: @tr("Problem or idea?");
                    CheckButton {
                        small: true;
                        text: @tr("Report…");
                        clicked => { root.page = 2; }
                    }
                }
                Hint { text: @tr("No GitHub account needed."); }
                SettingRow {
                    text: @tr("Events and errors");
                    CheckButton {
                        small: true;
                        text: @tr("Show log file");
                        clicked => { Shared.show-log(); }
                    }
                }
                SettingRow {
                    text: @tr("Like CineMosaic?");
                    CheckButton {
                        small: true;
                        text: @tr("Buy me a coffee");
                        clicked => { root.open-coffee(); }
                    }
                }
                Hint { text: @tr("If you use CineMosaic and like it, I would be glad if you bought me a coffee."); }
            }

            // Selbsttest wie Mountpoints SelfTestView: feste Liste mit Rahmen, die mitscrollt – das Fenster wächst nie
            if root.tab == 2 && root.page == 1: VerticalLayout {
                width: root.column;
                alignment: start;
                // Liste 200 hoch wie in Mountpoint: etwas engere Abstände, damit alles ohne Scrollen passt
                spacing: 10px;
                Section {
                    title: @tr("SELF-TEST");
                    spacing: 8px;
                    if root.test-phase == 0: Text {
                        width: root.column;
                        wrap: word-wrap;
                        font-size: 12px;
                        color: Theme.muted;
                        text: @tr("CineMosaic tests ffmpeg, grabbing frames, reading cut lists, saving sheets and updates on test data of its own and sends us an anonymous report. Your volumes are only listed, never changed. It takes less than a minute.");
                    }
                    if root.test-phase != 0: FieldFrame {
                        height: 200px;
                        flick := Flickable {
                            content-height: list.preferred-height;
                            // neue Zeile → ans Ende scrollen, wie Mountpoints scrollTo
                            property <length> filled: list.preferred-height;
                            changed filled => { self.content-y = min(0px, self.height - self.filled); }
                            list := VerticalLayout {
                                width: flick.width;
                                padding: 10px;
                                spacing: 8px;
                                for row in root.test-rows: HorizontalLayout {
                                    spacing: 8px;
                                    VerticalLayout {
                                        alignment: start;
                                        padding-top: 2px;
                                        Image {
                                            width: 12px;
                                            height: 12px;
                                            source: row.status == 0 ? @image-url("../assets/tabs/pass.png") : row.status == 1 ? @image-url("../assets/tabs/fail.png") : @image-url("../assets/tabs/skip.png");
                                            colorize: row.status == 0 ? Theme.online : row.status == 1 ? Theme.error : Theme.faint;
                                            accessible-role: image;
                                            accessible-label: row.status == 0 ? @tr("Passed") : row.status == 1 ? @tr("Failed") : @tr("Skipped");
                                        }
                                    }
                                    VerticalLayout {
                                        spacing: 2px;
                                        Text { text: row.title; font-size: 12px; color: Theme.text; }
                                        Text {
                                            width: root.column - 42px;
                                            text: row.detail;
                                            wrap: word-wrap;
                                            font-size: 10px;
                                            color: row.status == 1 ? Theme.error : Theme.faint;
                                        }
                                    }
                                }
                                if root.test-phase == 1: HorizontalLayout {
                                    spacing: 8px;
                                    VerticalLayout {
                                        alignment: center;
                                        Spinner { indeterminate: true; width: 12px; height: 12px; }
                                    }
                                    Text { text: root.test-current; font-size: 12px; color: Theme.muted; }
                                }
                            }
                        }
                        ScrollThumb { x: parent.width - self.width - 2px; view: flick.height; content: list.preferred-height; offset: flick.content-y; }
                    }
                    if root.test-phase == 2: VerticalLayout {
                        padding-top: 2px;
                        spacing: 4px;
                        Text {
                            text: root.test-summary;
                            font-size: 12px;
                            font-weight: 600;
                            color: root.test-failed ? Theme.error : Theme.text;
                        }
                        Text {
                            width: root.column;
                            wrap: word-wrap;
                            font-size: 11px;
                            color: Theme.faint;
                            text: root.test-note != "" ? root.test-note : @tr("Only anonymous data is sent: system, test results and the log with user and folder names replaced. Save the report to look at it first.");
                        }
                    }
                }
                Divider { }
                HorizontalLayout {
                    spacing: 10px;
                    CheckButton {
                        small: true;
                        text: root.test-phase == 1 ? @tr("Hide") : @tr("Back");
                        clicked => { root.back(); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    if root.test-phase == 0: CheckButton {
                        small: true;
                        text: @tr("Start self-test");
                        primary: true;
                        clicked => { root.start-selftest(); }
                    }
                    if root.test-phase == 1: VerticalLayout {
                        alignment: center;
                        Spinner { indeterminate: true; width: 16px; height: 16px; }
                    }
                    if root.test-phase == 2: CheckButton {
                        small: true;
                        text: @tr("Save report");
                        clicked => { root.save-selftest(); }
                    }
                    if root.test-phase == 2: CheckButton {
                        small: true;
                        text: root.sending ? @tr("Sending…") : @tr("Send report");
                        primary: true;
                        enabled: !root.sending;
                        clicked => { root.send-selftest(); }
                    }
                }
            }

            // Problem melden wie Mountpoints ProblemView: Felder mit Linie, ohne eigene Fläche
            if root.tab == 2 && root.page == 2: VerticalLayout {
                width: root.column;
                alignment: start;
                spacing: 12px;
                Section {
                    title: @tr("REPORT A PROBLEM");
                    spacing: 12px;
                    Text {
                        width: root.column;
                        wrap: word-wrap;
                        font-size: 12px;
                        color: Theme.muted;
                        text: @tr("What happened, and what did you expect? Ideas are welcome too. No GitHub account needed.");
                    }
                    FieldFrame {
                        height: 100px;
                        editor := Flickable {
                            x: 6px;
                            y: 6px;
                            width: parent.width - 12px;
                            height: parent.height - 12px;
                            content-height: max(self.height, description.preferred-height);
                            // beim Tippen am Ende bleiben, wenn der Text länger als das Feld wird
                            property <length> filled: description.preferred-height;
                            changed filled => { self.content-y = min(0px, self.height - self.filled); }
                            description := TextInput {
                                width: editor.width;
                                font-size: 12px;
                                color: Theme.text;
                                selection-background-color: Theme.accent.with-alpha(0.35);
                                wrap: word-wrap;
                                single-line: false;
                                text <=> root.report-text;
                                accessible-label: @tr("Description");
                            }
                        ScrollThumb { x: parent.width - self.width - 2px; view: editor.height; content: description.preferred-height; offset: editor.content-y; y: 6px + 2px + (description.preferred-height > editor.height ? -editor.content-y / (description.preferred-height - editor.height) * (editor.height - 4px - self.height) : 0px); }
                        }
                    }
                    FieldFrame {
                        height: 26px;
                        if root.report-contact == "": Text {
                            x: 8px;
                            text: @tr("Email for questions (optional)");
                            font-size: 12px;
                            color: Theme.faint;
                            vertical-alignment: center;
                            height: parent.height;
                        }
                        TextInput {
                            x: 8px;
                            width: parent.width - 16px;
                            height: parent.height;
                            font-size: 12px;
                            color: Theme.text;
                            selection-background-color: Theme.accent.with-alpha(0.35);
                            vertical-alignment: center;
                            single-line: true;
                            text <=> root.report-contact;
                            accessible-label: @tr("Email for questions (optional)");
                        }
                    }
                    SettingRow {
                        text: @tr("Attach system info and log file");
                        VerticalLayout {
                            alignment: center;
                            Switch {
                                on: root.report-attach;
                                label: @tr("Attach system info and log file");
                                toggled => { root.report-attach = !root.report-attach; }
                            }
                        }
                    }
                    Text {
                        width: root.column;
                        wrap: word-wrap;
                        font-size: 11px;
                        color: Theme.faint;
                        text: @tr("Anonymized: your user name and folder names are replaced.");
                    }
                }
                Divider { }
                HorizontalLayout {
                    spacing: 10px;
                    CheckButton {
                        small: true;
                        text: @tr("Back");
                        clicked => { root.back(); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    CheckButton {
                        small: true;
                        text: root.sending ? @tr("Sending…") : @tr("Send");
                        primary: true;
                        enabled: !root.sending && root.report-text != "";
                        clicked => { root.send-problem(); }
                    }
                }
            }

            // Über wie Mountpoints AboutView: Symbol, Name, Version, ©; Lizenz; Knöpfe; Drittanbieter
            if root.tab == 3: VerticalLayout {
                width: root.column;
                alignment: start;
                spacing: 16px;
                HorizontalLayout {
                    spacing: 14px;
                    alignment: start;
                    Image {
                        source: @image-url("../assets/icon.png");
                        width: 56px;
                        height: 56px;
                    }
                    VerticalLayout {
                        spacing: 4px;
                        alignment: center;
                        Text { text: "CineMosaic"; font-size: 15px; font-weight: 600; color: Theme.text; }
                        Text { text: @tr("Version {}", root.version); font-size: 12px; color: Theme.muted; }
                        Text { text: "© 2026 Moritz Poth"; font-size: 12px; color: Theme.muted; }
                    }
                }
                Text {
                    width: root.column;
                    wrap: word-wrap;
                    font-size: 12px;
                    color: Theme.text;
                    text: @tr("CineMosaic is free software: you can redistribute and modify it under the terms of the GNU General Public License, version 3 or later.");
                }
                Text {
                    width: root.column;
                    wrap: word-wrap;
                    font-size: 12px;
                    color: Theme.text;
                    text: @tr("It comes with ABSOLUTELY NO WARRANTY – use at your own risk.");
                }
                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;
                    CheckButton {
                        small: true;
                        text: @tr("Source code");
                        clicked => { root.open-source(); }
                    }
                    CheckButton {
                        small: true;
                        text: @tr("License");
                        clicked => { root.open-license(); }
                    }
                }
                VerticalLayout {
                    spacing: 6px;
                    Text { text: @tr("THIRD-PARTY"); font-size: 11px; font-weight: 600; letter-spacing: 1px; color: Theme.muted; }
                    Text {
                        width: root.column;
                        wrap: word-wrap;
                        font-size: 11px;
                        color: Theme.faint;
                        text: @tr("JetBrains Mono font – SIL Open Font License 1.1. Slint UI toolkit – used under the GNU GPL v3. FFmpeg – GNU GPL. Bin and AAF format knowledge from pyavb and pyaaf2 by Mark Reid (MIT).");
                    }
                    Text {
                        width: root.column;
                        wrap: word-wrap;
                        font-size: 11px;
                        color: Theme.faint;
                        text: @tr("Avid and Media Composer are trademarks of Avid Technology, Inc. CineMosaic is not affiliated with Avid.");
                    }
                }
            }
        }
    }

    // Toast wie Mountpoints .toast: unten mittig (44 über dem Rand), so breit wie der Text, gleitet von unten herein
    if root.toast-text != "": Rectangle {
        x: (root.width - self.width) / 2;
        y: root.toast-visible ? root.height - self.height - 44px : root.height;
        opacity: root.toast-visible ? 1 : 0;
        animate y, opacity { duration: 200ms; easing: ease-out; }
        width: min(measure.preferred-width, root.width - 60px) + 28px;
        // ungebrochene Breite des Textes (der Toast ist so breit wie sein Text, höchstens fast fensterbreit)
        measure := Text { visible: false; text: root.toast-text; font-size: 11px; font-weight: 600; }
        height: toast.preferred-height + 18px;
        border-radius: 8px;
        background: root.toast-ok ? Theme.online : Theme.background;
        border-width: root.toast-ok ? 0px : 1px;
        border-color: Theme.partial;
        drop-shadow-blur: 10px;
        drop-shadow-offset-y: 4px;
        drop-shadow-color: #00000040;
        toast := Text {
            width: parent.width - 28px;
            text: root.toast-text;
            wrap: word-wrap;
            font-size: 11px;
            font-weight: 600;
            color: root.toast-ok ? Theme.on-primary : Theme.text;
            accessible-role: text;
        }
    }
}

// Tabs of the side column: one segmented bar, the current segment filled
component TabStrip inherits Rectangle {
    in property <[string]> items;
    in-out property <int> current;
    height: 30px;
    border-radius: 8px;
    background: Theme.text.with-alpha(0.06);
    HorizontalLayout {
        padding: 2px;
        spacing: 2px;
        for item[i] in root.items: Rectangle {
            border-radius: 6px;
            background: i == root.current ? Theme.background : t.has-hover ? Theme.text.with-alpha(0.05) : transparent;
            drop-shadow-blur: i == root.current ? 2px : 0px;
            drop-shadow-color: #00000033;
            accessible-role: tab;
            accessible-label: item;
            accessible-checked: i == root.current;
            accessible-action-default => { root.current = i; }
            Text {
                text: item;
                font-size: 12px;
                font-weight: i == root.current ? 600 : 400;
                color: i == root.current ? Theme.text : Theme.muted;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            t := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.current = i; }
            }
        }
    }
}

// B / I: pressed look while on
component StyleToggle inherits Rectangle {
    in property <string> text;
    in property <string> label;
    in property <bool> on;
    in property <bool> bold;
    in property <bool> italic;
    callback toggled;
    width: 26px;
    height: 26px;
    border-radius: 6px;
    border-width: 1px;
    border-color: root.on ? Theme.primary : Theme.line;
    background: root.on ? Theme.primary : touch.has-hover ? Theme.text.with-alpha(0.06) : transparent;
    accessible-role: switch;
    accessible-label: root.label;
    accessible-checked: root.on;
    accessible-action-default => { root.toggled(); }
    Text {
        text: root.text;
        font-family: "Helvetica Neue";
        font-size: 13px;
        font-weight: root.bold ? 700 : 400;
        font-italic: root.italic;
        color: root.on ? Theme.on-primary : Theme.text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }
}

// Colour: a few swatches and a hex field; the square at the right shows the colour Rust read
component ColorRow inherits HorizontalLayout {
    in property <string> text;
    in-out property <string> value;
    in property <color> shown;
    in property <bool> invalid;
    callback edited();
    spacing: 6px;
    height: 30px;
    Text {
        text: root.text;
        font-size: 12px;
        horizontal-stretch: 1;
        vertical-alignment: center;
        color: Theme.text;
    }
    for sw in [
        { c: #000000, hex: "#000000", name: @tr("Black") },
        { c: #3c4146, hex: "#3c4146", name: @tr("Dark grey") },
        { c: #8a8f94, hex: "#8a8f94", name: @tr("Grey") },
        { c: #ffffff, hex: "#ffffff", name: @tr("White") },
        { c: #b3261e, hex: "#b3261e", name: @tr("Red") },
    ]: VerticalLayout {
        alignment: center;
        Rectangle {
            width: 18px;
            height: 18px;
            border-radius: 9px;
            background: sw.c;
            border-width: root.value == sw.hex ? 2px : 1px;
            border-color: root.value == sw.hex ? Theme.accent : Theme.line;
            accessible-role: button;
            accessible-label: sw.name;
            accessible-checked: root.value == sw.hex;
            accessible-action-default => { root.value = sw.hex; root.edited(); }
            TouchArea {
                mouse-cursor: pointer;
                clicked => { root.value = sw.hex; root.edited(); }
            }
        }
    }
    FieldFrame {
        width: 78px;
        height: 26px;
        border-color: root.invalid ? Theme.error : hex.has-focus ? Theme.accent : Theme.line;
        hex := TextInput {
            x: 6px;
            width: parent.width - 30px;
            height: parent.height;
            text <=> root.value;
            font-size: 11px;
            color: Theme.text;
            vertical-alignment: center;
            single-line: true;
            accessible-label: root.text;
            edited => { root.edited(); }
        }
        Rectangle {
            x: parent.width - 20px;
            y: 6px;
            width: 14px;
            height: 14px;
            border-radius: 3px;
            background: root.shown;
            border-width: 1px;
            border-color: Theme.line;
        }
    }
}

// small text button of the zoom controls
component ZoomButton {
    in property <string> text;
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked;
    min-width: max(26px, t.preferred-width + 14px);
    height: 26px;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    Rectangle {
        border-radius: 6px;
        background: !root.enabled ? transparent : touch.pressed ? Theme.text.with-alpha(0.14) : touch.has-hover ? Theme.text.with-alpha(0.07) : transparent;
    }
    t := Text {
        text: root.text;
        font-size: root.text.character-count == 1 ? 15px : 11px;
        color: root.enabled ? Theme.text : Theme.disabled;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

export component AppWindow inherits SheetWindow {
    title: "CineMosaic";
    // resizable; never smaller than the side column needs (user 2026-11-20)
    min-width: root.smallest-width;
    min-height: root.smallest-height;
    out property <length> smallest-width: 1000px;
    // what the side column needs; Rust lowers it to the screen on small displays
    in-out property <length> smallest-height: 820px;
    preferred-width: 1180px;
    preferred-height: 920px;
    // app menu item, translated (Rust puts it into the macOS app menu)
    out property <string> txt-settings-menu: @tr("Settings…");

    // source: 0 master file + cut list, 1 Media Composer bin
    in-out property <int> mode;
    in property <string> bin-name;
    in property <[string]> sequences;
    in property <int> sequence;
    in property <[VolumeRow]> volumes;
    in property <string> master-name;
    in property <string> list-name;
    in property <string> source-info;
    in property <string> source-error;
    // 0 nothing grabbed yet, 1 grabbing, 2 stills ready
    in property <int> state;
    in property <float> progress;
    in property <string> work-text;
    in property <string> time-left;
    in property <bool> paused;
    in property <bool> can-grab;
    // sheet (index into the paper list: 0 custom, 1.. A0..A6)
    in-out property <int> paper: 5;
    // picture format: 0 full frame (no crop), 1..7 the formats in layout::PICTURE, 8 custom
    in-out property <int> picture: 0;
    in-out property <string> custom-aspect: "2.39";
    in-out property <bool> landscape: true;
    // side column tab: 0 source, 1 sheet, 2 design
    in-out property <int> side-tab;
    // crop marks: trim area in the picture format
    in-out property <bool> trim;
    // frame line and headline; colours as "#rrggbb", the swatch shows what Rust read
    in-out property <bool> line-on;
    in-out property <string> line-width: "0.5";
    in-out property <string> line-inset: "6";
    in-out property <string> line-color: "#000000";
    in property <color> line-swatch: black;
    in-out property <string> headline;
    in property <[string]> fonts;
    in-out property <int> font;
    in-out property <string> head-size: "24";
    in-out property <bool> head-bold;
    in-out property <bool> head-italic;
    in-out property <string> head-color: "#000000";
    in property <color> head-swatch: black;
    // 0–2 top left / centre / right, 3–5 bottom
    in-out property <int> head-pos: 1;
    in-out property <string> custom-w: "500";
    in-out property <string> custom-h: "700";
    in-out property <string> dpi: "300";
    in-out property <string> margin: "10";
    in-out property <string> gap: "3";
    in-out property <bool> auto-cols: true;
    in-out property <string> cols: "4";
    // names of the fields Rust could not read ("dpi", "margin", …)
    in property <string> invalid;
    in property <string> sheet-info;
    // preview
    in property <image> preview;
    // zoom of the preview: 1 = the whole page fits; pan = offset of the page centre from the centre of the desk
    in-out property <float> zoom: 1;
    in-out property <length> pan-x;
    in-out property <length> pan-y;
    // Rust renders a sharper preview once the zoom stops changing
    callback zoom-changed(float);
    in property <float> page-aspect: 210 / 297;
    // export
    in-out property <int> export-format: 3;
    in property <bool> exporting;
    in property <string> export-status;
    in property <bool> can-reveal;

    callback pick-master();
    callback mode-chosen(int);
    callback pick-bin();
    callback sequence-chosen(int);
    callback toggle-volume(int);
    callback pick-list();
    callback grab();
    callback pause(bool);
    callback cancel();
    callback sheet-changed();
    callback export();
    callback reveal();

    HorizontalLayout {
        // side column
        Rectangle {
            width: Metrics.side-width;
            background: Theme.sidebar;
            VerticalLayout {
                padding: 28px;
                padding-top: 22px;
                spacing: 6px;
                Headline { }
                if Shared.update-version != "": VerticalLayout {
                    padding-bottom: 10px;
                    UpdateOffer { text-width: Metrics.text-width; }
                }
                TabStrip {
                    items: [@tr("Source"), @tr("Sheet"), @tr("Design")];
                    current <=> root.side-tab;
                }
                Rectangle { height: 6px; }

                // alignment start: free space goes below, never between the rows
                if root.side-tab == 0: VerticalLayout {
                    spacing: 6px;
                    alignment: start;
                    vertical-stretch: 1;
                    Row {
                        text: @tr("Source");
                        Dropdown {
                            label: @tr("Source");
                            items: [@tr("Master file + cut list"), @tr("Media Composer bin")];
                            current: root.mode;
                            selected(i) => { root.mode = i; root.mode-chosen(i); }
                        }
                    }
                    if root.mode == 0: VerticalLayout {
                        spacing: 6px;
                        Row {
                            text: @tr("Master file");
                            CheckButton { text: @tr("Choose…"); small: true; enabled: root.state != 1; clicked => { root.pick-master(); } }
                        }
                        if root.master-name != "": Para { text: root.master-name; color: Theme.muted; }
                        Row {
                            text: @tr("Cut list");
                            CheckButton { text: @tr("Choose…"); small: true; enabled: root.state != 1; clicked => { root.pick-list(); } }
                        }
                        if root.list-name != "": Para { text: root.list-name; color: Theme.muted; }
                    }
                    if root.mode == 1: VerticalLayout {
                        spacing: 6px;
                        Row {
                            text: @tr("Bin");
                            CheckButton { text: @tr("Choose…"); small: true; enabled: root.state != 1; clicked => { root.pick-bin(); } }
                        }
                        if root.bin-name != "": Para { text: root.bin-name; color: Theme.muted; }
                        if root.sequences.length > 0: Row {
                            text: @tr("Sequence");
                            Dropdown {
                                label: @tr("Sequence");
                                items: root.sequences;
                                current: root.sequence;
                                selected(i) => { root.sequence-chosen(i); }
                            }
                        }
                        Text { text: @tr("Volumes with Avid MediaFiles"); font-size: 12px; color: Theme.text; height: 24px; vertical-alignment: center; }
                        if root.volumes.length == 0: Para { text: @tr("No volume with an Avid MediaFiles folder is connected."); }
                        // shortcut: a plain scroll area without a thumb; enough for the usual handful of volumes
                        Flickable {
                            height: min(root.volumes.length * 28px, 112px);
                            content-height: root.volumes.length * 28px;
                            VerticalLayout {
                                for v[i] in root.volumes: HorizontalLayout {
                                    height: 28px;
                                    spacing: 10px;
                                    Text { text: v.name; font-size: 12px; color: Theme.muted; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                                    VerticalLayout {
                                        alignment: center;
                                        Switch { on: v.on; label: v.name; toggled => { root.toggle-volume(i); } }
                                    }
                                }
                            }
                        }
                    }
                    if root.source-error != "": Para { text: root.source-error; color: Theme.error; }
                    if root.source-info != "": Para { text: root.source-info; }
                    if root.state != 1: HorizontalLayout {
                        padding-top: 4px;
                        alignment: start;
                        CheckButton {
                            text: root.state == 2 ? @tr("Grab stills again") : @tr("Grab stills");
                            primary: root.state != 2;
                            enabled: root.can-grab;
                            clicked => { root.grab(); }
                        }
                    }
                    if root.state == 1: VerticalLayout {
                        padding-top: 4px;
                        spacing: 6px;
                        ProgressBar { value: root.progress; }
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: root.work-text; font-size: 11px; color: Theme.muted; overflow: elide; horizontal-stretch: 1; }
                            Text { text: root.paused ? @tr("Paused") : root.time-left; font-size: 11px; color: Theme.muted; horizontal-stretch: 0; }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: end;
                            CheckButton { text: root.paused ? @tr("Resume") : @tr("Pause"); small: true; clicked => { root.pause(!root.paused); } }
                            CheckButton { text: @tr("Cancel"); small: true; clicked => { root.cancel(); } }
                        }
                    }
                }
                // alignment start: free space goes below, never between the rows
                if root.side-tab == 1: VerticalLayout {
                    spacing: 6px;
                    alignment: start;
                    vertical-stretch: 1;
                    Row {
                        text: @tr("Picture format");
                        Dropdown {
                            label: @tr("Picture format");
                            items: [@tr("Full frame"), "4:3 (1.33)", "1.66", "16:9 (1.78)", "1.85", "2.00", "2.35", "2.39", @tr("Custom")];
                            current: root.picture;
                            selected(i) => { root.picture = i; root.sheet-changed(); }
                        }
                    }
                    if root.picture == 8: Row {
                        text: @tr("Width : height");
                        NumberField { text <=> root.custom-aspect; unit: ":1"; label: @tr("Picture format"); invalid: root.invalid == "aspect"; edited => { root.sheet-changed(); } }
                    }
                    if root.picture != 0: Para { text: @tr("Black bars outside this format are cut off (top and bottom or left and right)."); }
                    Row {
                        text: @tr("Paper");
                        Dropdown {
                            label: @tr("Paper");
                            items: [@tr("Custom"), "A0", "A1", "A2", "A3", "A4", "A5", "A6"];
                            current: root.paper;
                            selected(i) => { root.paper = i; root.sheet-changed(); }
                        }
                    }
                    if root.paper == 0: Row {
                        text: @tr("Width × height");
                        NumberField { text <=> root.custom-w; unit: "mm"; label: @tr("Width"); invalid: root.invalid == "width"; edited => { root.sheet-changed(); } }
                        NumberField { text <=> root.custom-h; unit: "mm"; label: @tr("Height"); invalid: root.invalid == "height"; edited => { root.sheet-changed(); } }
                    }
                    Row {
                        text: @tr("Orientation");
                        Dropdown {
                            label: @tr("Orientation");
                            items: [@tr("Portrait"), @tr("Landscape")];
                            current: root.landscape ? 1 : 0;
                            selected(i) => { root.landscape = i == 1; root.sheet-changed(); }
                        }
                    }
                    Row {
                        text: @tr("Resolution");
                        NumberField { text <=> root.dpi; unit: "dpi"; label: @tr("Resolution"); invalid: root.invalid == "dpi"; edited => { root.sheet-changed(); } }
                    }
                    Row {
                        text: @tr("Margin");
                        NumberField {
                            text <=> root.margin; unit: "mm"; label: @tr("Margin"); invalid: root.invalid == "margin";
                            edited => { if root.margin.is-float() { margin-slider.value = root.margin.to-float(); } root.sheet-changed(); }
                        }
                    }
                    // slider in half millimetres; the field above takes any value
                    margin-slider := Slider {
                        minimum: 0;
                        maximum: 40;
                        step: 0.5;
                        value: root.margin.is-float() ? root.margin.to-float() : 10;
                        accessible-label: @tr("Margin");
                        changed(v) => { root.margin = Math.round(v * 2) / 2; root.sheet-changed(); }
                    }
                    Row {
                        text: @tr("Gap between stills");
                        NumberField {
                            text <=> root.gap; unit: "mm"; label: @tr("Gap between stills"); invalid: root.invalid == "gap";
                            edited => { if root.gap.is-float() { gap-slider.value = root.gap.to-float(); } root.sheet-changed(); }
                        }
                    }
                    gap-slider := Slider {
                        minimum: 0;
                        maximum: 20;
                        step: 0.5;
                        value: root.gap.is-float() ? root.gap.to-float() : 3;
                        accessible-label: @tr("Gap between stills");
                        changed(v) => { root.gap = Math.round(v * 2) / 2; root.sheet-changed(); }
                    }
                    Row {
                        text: @tr("Columns automatic");
                        VerticalLayout {
                            alignment: center;
                            Switch { on: root.auto-cols; label: @tr("Columns automatic"); toggled => { root.auto-cols = !root.auto-cols; root.sheet-changed(); } }
                        }
                    }
                    if !root.auto-cols: Row {
                        text: @tr("Columns");
                        NumberField { text <=> root.cols; unit: ""; label: @tr("Columns"); invalid: root.invalid == "columns"; edited => { root.sheet-changed(); } }
                    }
                    Row {
                        text: @tr("Crop marks");
                        VerticalLayout {
                            alignment: center;
                            Switch { on: root.trim; label: @tr("Crop marks"); toggled => { root.trim = !root.trim; root.sheet-changed(); } }
                        }
                    }
                    if root.trim: Para { text: @tr("The sheet is laid out in an area of the picture format inside the paper, with crop marks at its corners to cut it out."); }
                    Para { text: root.sheet-info; }
                }
                // alignment start: free space goes below, never between the rows
                if root.side-tab == 2: VerticalLayout {
                    spacing: 6px;
                    alignment: start;
                    vertical-stretch: 1;
                    SectionLabel { text: @tr("LINE"); }
                    Row {
                        text: @tr("Frame line");
                        VerticalLayout {
                            alignment: center;
                            Switch { on: root.line-on; label: @tr("Frame line"); toggled => { root.line-on = !root.line-on; root.sheet-changed(); } }
                        }
                    }
                    if root.line-on: VerticalLayout {
                        spacing: 6px;
                        Row {
                            text: @tr("Thickness");
                            NumberField { text <=> root.line-width; unit: "mm"; label: @tr("Thickness"); invalid: root.invalid == "line-width"; edited => { root.sheet-changed(); } }
                        }
                        Row {
                            text: @tr("Distance from the edge");
                            NumberField {
                                text <=> root.line-inset; unit: "mm"; label: @tr("Distance from the edge"); invalid: root.invalid == "line-inset";
                                edited => { if root.line-inset.is-float() { inset-slider.value = root.line-inset.to-float(); } root.sheet-changed(); }
                            }
                        }
                        inset-slider := Slider {
                            minimum: 0;
                            maximum: 40;
                            step: 0.5;
                            value: root.line-inset.is-float() ? root.line-inset.to-float() : 6;
                            accessible-label: @tr("Distance from the edge");
                            changed(v) => { root.line-inset = Math.round(v * 2) / 2; root.sheet-changed(); }
                        }
                        ColorRow { text: @tr("Colour"); value <=> root.line-color; shown: root.line-swatch; invalid: root.invalid == "line-color"; edited => { root.sheet-changed(); } }
                    }

                    Rectangle { height: 10px; }
                    SectionLabel { text: @tr("HEADLINE"); }
                    FieldFrame {
                        height: 26px;
                        border-color: head-input.has-focus ? Theme.accent : Theme.line;
                        if root.headline == "": Text {
                            x: 8px;
                            height: parent.height;
                            text: @tr("Headline (empty = none)");
                            font-size: 12px;
                            color: Theme.faint;
                            vertical-alignment: center;
                        }
                        head-input := TextInput {
                            x: 8px;
                            width: parent.width - 16px;
                            height: parent.height;
                            text <=> root.headline;
                            font-size: 12px;
                            color: Theme.text;
                            vertical-alignment: center;
                            single-line: true;
                            accessible-label: @tr("Headline");
                            edited => { root.sheet-changed(); }
                        }
                    }
                    if root.headline != "": VerticalLayout {
                        spacing: 6px;
                        Row {
                            text: @tr("Font");
                            if root.fonts.length > 0: Dropdown {
                                label: @tr("Font");
                                items: root.fonts;
                                current: root.font;
                                selected(i) => { root.font = i; root.sheet-changed(); }
                            }
                        }
                        Row {
                            text: @tr("Size");
                            StyleToggle { text: "B"; bold: true; label: @tr("Bold"); on: root.head-bold; toggled => { root.head-bold = !root.head-bold; root.sheet-changed(); } }
                            StyleToggle { text: "I"; italic: true; label: @tr("Italic"); on: root.head-italic; toggled => { root.head-italic = !root.head-italic; root.sheet-changed(); } }
                            NumberField { text <=> root.head-size; unit: "pt"; label: @tr("Size"); invalid: root.invalid == "head-size"; edited => { root.sheet-changed(); } }
                        }
                        ColorRow { text: @tr("Colour"); value <=> root.head-color; shown: root.head-swatch; invalid: root.invalid == "head-color"; edited => { root.sheet-changed(); } }
                        Row {
                            text: @tr("Position");
                            Dropdown {
                                label: @tr("Position");
                                items: [@tr("Top left"), @tr("Top centre"), @tr("Top right"), @tr("Bottom left"), @tr("Bottom centre"), @tr("Bottom right")];
                                current: root.head-pos;
                                selected(i) => { root.head-pos = i; root.sheet-changed(); }
                            }
                        }
                        Para { text: root.line-on ? @tr("The headline sits on the frame line; the line breaks around it.") : @tr("Without a frame line the headline sits at the line's distance from the edge."); }
                    }
                }

                // export stays at the bottom on every tab
                SectionLabel { text: @tr("EXPORT"); }
                Row {
                    text: @tr("Format");
                    Dropdown {
                        label: @tr("Format");
                        items: ["PNG", "TIFF", "JPEG", "PDF"];
                        current: root.export-format;
                        selected(i) => { root.export-format = i; }
                    }
                    CheckButton {
                        text: root.exporting ? @tr("Saving…") : @tr("Save…");
                        small: true;
                        primary: root.state == 2;
                        enabled: root.state == 2 && !root.exporting;
                        clicked => { root.export(); }
                    }
                }
                if root.export-status != "": Para { text: root.export-status; color: Theme.muted; }
                if root.can-reveal: HorizontalLayout {
                    alignment: start;
                    CheckButton { text: @tr("Show in Finder"); small: true; clicked => { root.reveal(); } }
                }
            }
        }

        // preview: the page on the desk, as large as fits
        desk := Rectangle {
            background: Theme.desk;
            clip: true;
            property <length> room-w: self.width - 64px;
            property <length> room-h: self.height - 64px;
            property <bool> wide: self.room-w / self.room-h > root.page-aspect;
            // page size when it fits
            property <length> fit-w: desk.wide ? desk.room-h * root.page-aspect : desk.room-w;
            property <length> fit-h: desk.wide ? desk.room-h : desk.room-w / root.page-aspect;
            property <float> start-zoom: 1;
            property <length> start-x;
            property <length> start-y;
            // the page may move until 40 px of it are left in view; when it fits it stays centred
            function clamp-pan() {
                root.pan-x = clamp(root.pan-x, -max(0px, (desk.fit-w * root.zoom - desk.width) / 2 + 40px), max(0px, (desk.fit-w * root.zoom - desk.width) / 2 + 40px));
                root.pan-y = clamp(root.pan-y, -max(0px, (desk.fit-h * root.zoom - desk.height) / 2 + 40px), max(0px, (desk.fit-h * root.zoom - desk.height) / 2 + 40px));
                if root.zoom <= 1 { root.pan-x = 0; root.pan-y = 0; }
            }
            // new zoom, the point (px, py) of the desk stays where it is
            function zoom-to(z: float, px: length, py: length) {
                let nz = clamp(z, 1, 8);
                let dx = px - desk.width / 2;
                let dy = py - desk.height / 2;
                root.pan-x = dx - (dx - root.pan-x) * nz / root.zoom;
                root.pan-y = dy - (dy - root.pan-y) * nz / root.zoom;
                root.zoom = nz;
                desk.clamp-pan();
                root.zoom-changed(nz);
            }
            changed width => { desk.clamp-pan(); }
            changed height => { desk.clamp-pan(); }

            page := Rectangle {
                width: desk.fit-w * root.zoom;
                height: desk.fit-h * root.zoom;
                x: (desk.width - self.width) / 2 + root.pan-x;
                y: (desk.height - self.height) / 2 + root.pan-y;
                background: white;
                drop-shadow-blur: 18px;
                drop-shadow-color: #00000059;
                drop-shadow-offset-y: 4px;
                Image {
                    width: parent.width;
                    height: parent.height;
                    source: root.preview;
                    image-fit: fill;
                    accessible-role: image;
                    accessible-label: @tr("Preview of the sheet");
                }
            }
            // pinch on the trackpad
            ScaleRotateGestureHandler {
                started => { desk.start-zoom = root.zoom; }
                updated => { desk.zoom-to(desk.start-zoom * self.scale, self.center.x, self.center.y); }
                // drag to move, scroll to move, ⌘ + scroll to zoom, double-click: fit / 200 %
                drag := TouchArea {
                    mouse-cursor: root.zoom > 1 ? (self.pressed ? MouseCursor.grabbing : MouseCursor.grab) : MouseCursor.default;
                    pointer-event(e) => {
                        if e.kind == PointerEventKind.down {
                            desk.start-x = root.pan-x;
                            desk.start-y = root.pan-y;
                        }
                    }
                    moved => {
                        if self.pressed && root.zoom > 1 {
                            root.pan-x = desk.start-x + self.mouse-x - self.pressed-x;
                            root.pan-y = desk.start-y + self.mouse-y - self.pressed-y;
                            desk.clamp-pan();
                        }
                    }
                    double-clicked => {
                        if root.zoom > 1 { desk.zoom-to(1, self.mouse-x, self.mouse-y); } else { desk.zoom-to(2, self.mouse-x, self.mouse-y); }
                    }
                    scroll-event(e) => {
                        if e.modifiers.control {
                            desk.zoom-to(root.zoom * Math.pow(1.0025, -e.delta-y / 1px), self.mouse-x, self.mouse-y);
                        } else if root.zoom > 1 {
                            root.pan-x += e.delta-x;
                            root.pan-y += e.delta-y;
                            desk.clamp-pan();
                        } else {
                            return reject;
                        }
                        accept
                    }
                }
            }
            // zoom controls, bottom right
            Rectangle {
                x: desk.width - self.width - 16px;
                y: desk.height - self.height - 16px;
                width: zoom-row.preferred-width;
                height: 30px;
                border-radius: 8px;
                background: Theme.background.with-alpha(0.92);
                border-width: 1px;
                border-color: Theme.line;
                zoom-row := HorizontalLayout {
                    padding: 2px;
                    padding-left: 4px;
                    padding-right: 4px;
                    spacing: 2px;
                    ZoomButton { text: "−"; label: @tr("Zoom out"); enabled: root.zoom > 1; clicked => { desk.zoom-to(root.zoom / 1.5, desk.width / 2, desk.height / 2); } }
                    Text {
                        text: Math.round(root.zoom * 100) + " %";
                        min-width: 52px;
                        font-size: 11px;
                        color: Theme.muted;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    ZoomButton { text: "+"; label: @tr("Zoom in"); enabled: root.zoom < 8; clicked => { desk.zoom-to(root.zoom * 1.5, desk.width / 2, desk.height / 2); } }
                    ZoomButton { text: @tr("Fit"); label: @tr("Fit the whole sheet"); enabled: root.zoom > 1; clicked => { desk.zoom-to(1, desk.width / 2, desk.height / 2); } }
                }
            }
            if root.state == 0 && root.source-info == "": Text {
                text: root.mode == 0 ? @tr("Choose a master file and its cut list.") : @tr("Choose a bin with your sequence.");
                font-size: 13px;
                color: #60666c;
                x: page.x + (page.width - self.width) / 2;
                y: page.y + (page.height - self.height) / 2;
            }
        }
    }
}
